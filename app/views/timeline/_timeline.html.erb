    SIDEBAR_HEADER: 11,
    GRID: 50,
    PROJECT_BAR: 200,
    TIMELINE_ROW: 300,
    TODAY_LINE: 555,
    DRAG_HELPER: 1001,
    POPUP_OVERLAY: 1002,
    POPUP_EDIT: 1003,
    COLOR_PICKER: 1004,
    BAR_HOVER: 9999,
    BAR_DRAGGING: 10000
  })
});

// 타임라인 상태 (모듈 패턴)
var TL_STATE = {
  isEditMode: false,
  isDirty: false,
  colors: {
    category: {},
    schedule: {}
  },
  currentTimelineName: 'Default',
  editing: {
    category: null,
    schedule: null,
    scheduleBar: null,
    colorTarget: null,
    selectedColor: TL_CONST.DEFAULT_COLOR,
    deletingCategoryIndex: null
  },

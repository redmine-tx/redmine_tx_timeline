    animationFrame: null,
    lastSyncTime: 0
  }
};

// 변경사항 추적 함수
function markDirty() {
  if (!TL_STATE.isDirty) {
    TL_STATE.isDirty = true;
    console.log('타임라인 변경사항 발생 - dirty 상태');
  }
}

function clearDirty() {
  TL_STATE.isDirty = false;
  console.log('타임라인 dirty 상태 해제');
}

// 타임라인 뷰포트 상태 (동적으로 확장 가능)
var TL_VIEWPORT = {
  originDate: new Date(<%= start_date.to_time.to_i * 1000 %>),
  endDate: new Date(<%= end_date.to_time.to_i * 1000 %>),
  totalDays: <%= days.length %>,
  totalWidth: <%= total_width %>,
  cellWidth: <%= cell_width %>,
  isLoading: false,
  isDraggingHeader: false
};

// 편집 모드 전환 함수
function setEditMode(enabled) {
  TL_STATE.isEditMode = enabled;
  var $container = $('.timeline-container');
  var $body = $('body');

  if (enabled) {
    $container.removeClass('timeline-readonly');
    $body.removeClass('timeline-readonly-page');
  } else {
    $container.addClass('timeline-readonly');
    $body.addClass('timeline-readonly-page');
  }

  // 모든 프로젝트 바의 draggable/resizable enable/disable
  $('.project-bar').each(function() {
    var $bar = $(this);
    if ($bar.hasClass('ui-draggable')) {
      $bar.draggable(enabled ? 'enable' : 'disable');
    }
    if ($bar.hasClass('ui-resizable')) {
      $bar.resizable(enabled ? 'enable' : 'disable');
    }
  });
}

// 하위 호환용 전역 변수 (기존 코드에서 직접 참조하는 것들)
var categoryColors = TL_STATE.colors.category;
var scheduleColors = TL_STATE.colors.schedule;
var cellWidth = TL_CONST.CELL_WIDTH;
var currentTimelineName = TL_STATE.currentTimelineName;
var currentEditingCategory = null;
var currentEditingSchedule = null;
var currentEditingScheduleBar = null;
var currentColorEditingTarget = null;
var selectedColor = TL_CONST.DEFAULT_COLOR;
var dragThreshold = TL_CONST.DRAG_THRESHOLD;
var deletingCategoryIndex = null;
var isScrollSyncing = false;
var syncAnimationFrame = null;

<script>
// 서버에서 전달받은 초기 타임라인 데이터
<% 
  # 전체 데이터를 JavaScript로 전달
%>
window.initialTimelineData = <%= json_escape(all_timelines_data.to_json).html_safe %>;

// 스크롤 동기화 기능 초기화 함수
function initializeScrollSync() {
  var $sidebar = $('.sidebar-content');
  var $timeline = $('.timeline-body');

  // 수평 스크롤바로 인한 높이 차이를 보정하여 스크롤 범위를 일치시킴
  function equalizeScrollRanges() {
    // 기존 보정값 초기화
    $sidebar.css('padding-bottom', '');

    var sidebarHeight = $sidebar[0].clientHeight;
    var timelineHeight = $timeline[0].clientHeight;
    var heightDiff = sidebarHeight - timelineHeight;

    // 사이드바가 더 높으면 (수평 스크롤바가 타임라인 공간을 차지한 경우)
    // 사이드바에 padding-bottom을 추가하여 동일한 maxScrollTop 유지
    if (heightDiff > 0) {
      $sidebar.css('padding-bottom', heightDiff + 'px');
    }
  }

  equalizeScrollRanges();
  $(window).on('resize', equalizeScrollRanges);

  // 동기식 스크롤 동기화 - requestAnimationFrame 없이 즉시 반영
  // scrollTop 대입이 상대쪽 scroll 이벤트를 동기적으로 발생시키므로
  // isSyncing 플래그만으로 피드백 루프를 차단할 수 있음
  var isSyncing = false;

  $sidebar.on('scroll', function() {
    if (isSyncing) return;
    isSyncing = true;
    $timeline[0].scrollTop = this.scrollTop;
    isSyncing = false;
  });

  $timeline.on('scroll', function() {
    if (isSyncing) return;
    isSyncing = true;
    $sidebar[0].scrollTop = this.scrollTop;
    isSyncing = false;
  });
}

// ============================================================
// 타임라인 좌측 무한 스크롤 - 과거 날짜 동적 로드
// ============================================================

function prependTimelineDays(monthsToAdd) {
  if (TL_VIEWPORT.isLoading) return;
  TL_VIEWPORT.isLoading = true;

  var $main = $('.timeline-main');
  // ★ DOM 변경 전에 scrollLeft 저장 (브라우저가 reflow로 값을 변경하기 전)
  var savedScrollLeft = $main[0].scrollLeft;

  var oldOrigin = new Date(TL_VIEWPORT.originDate.getTime());
  var newOrigin = new Date(oldOrigin);
  newOrigin.setMonth(newOrigin.getMonth() - monthsToAdd);
  newOrigin.setDate(1); // 월 시작일로 정규화

  // 추가되는 일수/너비 계산
  var addedDays = Math.round((oldOrigin - newOrigin) / (1000 * 60 * 60 * 24));
  var addedWidth = addedDays * TL_VIEWPORT.cellWidth;

  console.log('prependTimelineDays: ' + monthsToAdd + '개월 (' + addedDays + '일, ' + addedWidth + 'px) 추가, savedScrollLeft=' + savedScrollLeft);

  // 1. timeline-main-inner 너비를 먼저 업데이트 (컨테이너 확장)
  var newTotalWidth = TL_VIEWPORT.totalWidth + addedWidth;
  $('.timeline-main-inner').css('width', newTotalWidth + 'px');

  // 2. 일(day) 헤더 앞에 추가
  var newDayHeaderHtml = generateDayHeaderHtml(newOrigin, addedDays);
  $('.day-header').prepend(newDayHeaderHtml);

  // 3. 월(month) 헤더 앞에 추가
  var oldOriginPrevDay = new Date(oldOrigin.getTime() - 86400000);
  var newMonthHeaderHtml = generateMonthHeaderHtml(newOrigin, oldOriginPrevDay);
  $('.month-header').prepend(newMonthHeaderHtml);

  // 4. 기존 날짜 구분선을 오른쪽으로 이동 + 새 구분선 추가
  $('.date-grid-line').each(function() {
    var currentLeft = parseInt($(this).css('left')) || 0;
    $(this).css('left', (currentLeft + addedWidth) + 'px');
  });
  var newGridLinesHtml = generateGridLinesHtml(newOrigin, addedDays, 0);
  $('.date-grid-lines').prepend(newGridLinesHtml);

  // 5. 모든 타임라인 행에 셀 앞에 추가
  var newCategoryCellsHtml = generateCategoryCellsHtml(addedDays);
  var newEventCellsHtml = generateEventCellsHtml(newOrigin, addedDays);
  $('.timeline-row').each(function() {
    var $row = $(this);
    var $grid = $row.find('.timeline-grid');
    if ($row.hasClass('category-row')) {
      $grid.prepend(newCategoryCellsHtml);
    } else {
      $grid.prepend(newEventCellsHtml);
    }
  });

  // 6. 기존 프로젝트 바 위치를 오른쪽으로 이동
  $('.project-bar').each(function() {
    var currentLeft = parseInt($(this).css('left')) || 0;
    $(this).css('left', (currentLeft + addedWidth) + 'px');
  });

  // 7. 오늘 표시선 위치를 오른쪽으로 이동
  var $todayLine = $('.today-line');
  if ($todayLine.length > 0) {
    var todayLeft = parseInt($todayLine.css('left')) || 0;
    $todayLine.css('left', (todayLeft + addedWidth) + 'px');
  }

  // 8. scrollLeft 보정 (DOM 변경 전에 저장한 값 + 추가된 너비)
  var targetScrollLeft = savedScrollLeft + addedWidth;
  $main[0].scrollLeft = targetScrollLeft;

  // 9. TL_VIEWPORT 상태 업데이트
  TL_VIEWPORT.originDate = newOrigin;
  TL_VIEWPORT.totalDays += addedDays;
  TL_VIEWPORT.totalWidth = newTotalWidth;

  // 그리드 라인 높이 업데이트
  updateLineHeight();

  // ★ isLoading 해제를 약간 지연시켜 scroll 이벤트 재진입 방지
  setTimeout(function() {
    TL_VIEWPORT.isLoading = false;
  }, 50);
  console.log('타임라인 확장 완료: 새 시작일=' + formatLocalDate(newOrigin) + ', targetScrollLeft=' + targetScrollLeft);
}

// 이벤트 핸들러 등록 함수
function registerEventHandlers() {
  console.log('이벤트 핸들러 등록 시작');
  
  // ================================
  // 카테고리 관련 이벤트 핸들러
  // ================================
  
  // 카테고리 추가 버튼
  $('.add-category-btn').click(function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!TL_STATE.isEditMode) return;

    var categoryName = prompt('새 카테고리 이름을 입력하세요:');
    if (categoryName && categoryName.trim() !== '') {
      addNewCategory(categoryName.trim());
    }
  });

  // 카테고리 편집 버튼 (이름 + 색상 통합)
  $(document).on('click', '.edit-category-btn', function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!TL_STATE.isEditMode) return;

    var categoryHeader = $(this).closest('.category-header');
    var categoryIndex = categoryHeader.data('category-index');
    var categoryName = categoryHeader.find('.category-title').text().trim();

    currentColorEditingTarget = {
      type: 'category',
      categoryName: categoryName,
      categoryIndex: categoryIndex,
      categoryHeader: categoryHeader
    };

    $('#colorPickerTitle').text('카테고리 편집');
    $('#colorPickerTargetName').text(categoryName);

    // 이름 입력 필드 표시 및 값 설정
    $('#colorPickerNameSection').show();
    $('#colorPickerNameInput').val(categoryName);

    var currentColor = categoryColors[categoryName] || '#6c757d';
    selectedColor = currentColor;
    updateColorSelection(currentColor);

    $('#colorPickerPopup').addClass('show');
    setTimeout(function() { $('#colorPickerNameInput').focus().select(); }, 100);
  });

  // 카테고리 삭제 버튼
  $(document).on('click', '.delete-category-btn', function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!TL_STATE.isEditMode) return;

    var categoryHeader = $(this).closest('.category-header');
    var categoryName = categoryHeader.find('.category-title').text().trim();
    deletingCategoryIndex = categoryHeader.data('category-index');
    
    if (confirm('"' + categoryName + '" 카테고리와 모든 하위 이벤트를 삭제하시겠습니까?')) {
      confirmCategoryDelete();
    } else {
      deletingCategoryIndex = null;
    }
  });

  // 카테고리 토글 버튼
  $(document).on('click', '.category-toggle-btn', function(e) {
    e.preventDefault();
    e.stopPropagation();
    
    var categoryHeader = $(this).closest('.category-header');
    var categoryIndex = categoryHeader.data('category-index');
    var isCollapsed = categoryHeader.hasClass('category-collapsed');
    
    if (isCollapsed) {
      categoryHeader.removeClass('category-collapsed');
      $(this).removeClass('collapsed').text('▼');
      $('.project-item[data-category-index="' + categoryIndex + '"]').removeClass('hidden').show();
      showTimelineRows(categoryIndex);
      setTimeout(function() { updateLineHeight(); }, 50);
    } else {
      categoryHeader.addClass('category-collapsed');
      $(this).addClass('collapsed').text('▶');
      $('.project-item[data-category-index="' + categoryIndex + '"]').addClass('hidden');
      hideTimelineRows(categoryIndex);
      setTimeout(function() { updateLineHeight(); }, 50);
    }
  });

  // ================================
  // 이벤트 관련 이벤트 핸들러
  // ================================
  
  // 이벤트 추가 버튼
  $(document).on('click', '.add-event-btn', function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!TL_STATE.isEditMode) return;

    var categoryHeader = $(this).closest('.category-header');
    var categoryIndex = categoryHeader.data('category-index');
    var categoryName = categoryHeader.find('.category-title').text().trim();
    
    currentEditingCategory = { index: categoryIndex, name: categoryName };
    $('#eventCategoryName').text(categoryName);
    $('#eventName').val('');
    $('#eventPopup').addClass('show');
    
    setTimeout(function() { $('#eventName').focus(); }, 100);
  });

  // 이벤트 팝업 취소 버튼
  $('#cancelEventBtn').click(function(e) {
    e.preventDefault();
    hideEventPopup();
  });

  // 이벤트 팝업 배경 클릭 시 닫기
  $('#eventPopup').click(function(e) {
    if (e.target === this) {
      hideEventPopup();
    }
  });

  // 이벤트 폼 제출 처리
  $('#eventForm').submit(function(e) {
    e.preventDefault();
    
    var eventName = $('#eventName').val().trim();
    if (!eventName) {
      alert('이벤트 이름을 입력해주세요.');
      $('#eventName').focus();
      return;
    }
    
    if (!currentEditingCategory) {
      alert('카테고리 정보가 없습니다.');
      return;
    }
    
    addNewEvent(currentEditingCategory.index, { name: eventName });
    hideEventPopup();
  });

  // ================================
  // 타임라인 탭 관련 이벤트 핸들러
  // ================================
  
  // 탭 클릭 이벤트 핸들러
  $('.timeline-tab').click(function(e) {
    e.preventDefault();

    var timelineName = $(this).data('timeline-name');
    if (timelineName === currentTimelineName) return;

    function doSwitchTab() {
      // currentTimelineName 업데이트
      currentTimelineName = timelineName;
      TL_STATE.currentTimelineName = timelineName;

      // 선택된 탭 UI 업데이트
      selectTimelineTab(timelineName);

      // 선택된 타임라인 데이터 로드
      loadTimelineFromServer(timelineName);

      console.log('타임라인 탭 변경됨:', timelineName);
    }

    if (TL_STATE.isDirty) {
      showUnsavedChangesPopup(function onSave() {
        saveTimelineToServer(TL_STATE.currentTimelineName, true);
        doSwitchTab();
      }, function onDiscard() {
        clearDirty();
        doSwitchTab();
      });
      return;
    }

    doSwitchTab();
  });
  
  // 새 타임라인 추가 버튼 클릭 이벤트
  $('.add-timeline-btn').click(function(e) {
    e.preventDefault();
    
    // 새 타임라인 이름 입력받기
    var newTimelineName = prompt('새 타임라인의 이름을 입력하세요:', '');
    
    if (newTimelineName && newTimelineName.trim() !== '') {
      newTimelineName = newTimelineName.trim();
      
      // 서버에 새 타임라인 생성 요청
      $.ajax({
        url: '<%= create_timeline_project_timeline_index_path(@project) %>',
        method: 'POST',
        headers: {
          'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content'),
          'Content-Type': 'application/json'
        },
        data: JSON.stringify({
          name: newTimelineName
        }),
        success: function(response) {
          if (response.success) {
            alert('새 타임라인 "' + newTimelineName + '"이 생성되었습니다.');
            // 페이지 새로고침하여 새 탭 표시
            window.location.reload();
          } else {
            alert('로드맵 생성에 실패했습니다: ' + (response.message || '알 수 없는 오류'));
          }
        },
        error: function(xhr, status, error) {
          console.error('새 타임라인 생성 실패:', {
            status: xhr.status,
            statusText: xhr.statusText,
            responseText: xhr.responseText,
            error: error
          });
          alert('새 타임라인 생성 중 오류가 발생했습니다.\n\n상태: ' + xhr.status + '\n오류: ' + error);
        }
      });
    }
  });

  // 카테고리 삭제 확인 함수
  function confirmCategoryDelete() {
    if (deletingCategoryIndex === null) return;

    var categoryHeader = $('.category-header[data-category-index="' + deletingCategoryIndex + '"]');
    var categoryName = categoryHeader.find('.category-title').text().trim();

    console.log('카테고리 삭제 시작:', categoryName, '인덱스:', deletingCategoryIndex);

    // 카테고리 색상 정보 삭제
    delete categoryColors[categoryName];

    // 1. 타임라인에서 해당 카테고리의 행들 먼저 삭제 (사이드바 변경 전에)
    deleteTimelineRowsForCategory(deletingCategoryIndex);

    // 2. 해당 카테고리의 모든 프로젝트 아이템 삭제 (사이드바)
    var deletedProjectCount = $('.project-item[data-category-index="' + deletingCategoryIndex + '"]').length;
    $('.project-item[data-category-index="' + deletingCategoryIndex + '"]').remove();
    console.log('삭제된 프로젝트 아이템 수:', deletedProjectCount);

    // 3. 카테고리 헤더 삭제 (사이드바)
    categoryHeader.remove();

    console.log('카테고리 삭제 완료:', categoryName);
    deletingCategoryIndex = null;
    markDirty();
  }

  // 타임라인에서 카테고리 행들 삭제
  function deleteTimelineRowsForCategory(categoryIndex) {
    console.log('타임라인 카테고리 행 삭제 시작:', categoryIndex);

    var categoryName = $('.category-header[data-category-index="' + categoryIndex + '"] .category-title').text().trim();
    console.log('삭제할 카테고리 이름:', categoryName);

    if (!categoryName) {
      console.log('카테고리 이름을 찾을 수 없음 - 삭제 중단');
      return;
    }

    // 해당 카테고리의 모든 행 삭제 (이벤트 행 + 카테고리 행)
    $('.timeline-row[data-category-name="' + categoryName + '"]').remove();

    setTimeout(function() {
      updateLineHeight();
    }, 50);

    console.log('타임라인 카테고리 행 삭제 완료');
  }

  // 타임라인 행들 숨기기 함수
  function hideTimelineRows(categoryIndex) {
    var categoryName = $('.category-header[data-category-index="' + categoryIndex + '"] .category-title').text().trim();
    $('.timeline-row[data-category-name="' + categoryName + '"]').not('.category-row').addClass('hidden');
  }

  // 타임라인 행들 표시 함수
  function showTimelineRows(categoryIndex) {
    var categoryName = $('.category-header[data-category-index="' + categoryIndex + '"] .category-title').text().trim();
    $('.timeline-row[data-category-name="' + categoryName + '"]').not('.category-row').removeClass('hidden');
  }

  console.log('이벤트 핸들러 등록 완료');
}

$(document).ready(function() {  
  console.log('타임라인 초기화 시작');
  
  // 페이지 로드 시 초기 탭 선택
  selectTimelineTab(currentTimelineName);
  console.log('초기 탭 선택 완료:', currentTimelineName);
  
  // 초기 데이터로 페이지 구성
  if (window.initialTimelineData && window.initialTimelineData.categories) {
    console.log('초기 데이터로 페이지 구성 시작:', window.initialTimelineData);
    applyImportedData(window.initialTimelineData);
    console.log('초기 페이지 구성 완료');
  }
  
  // 기존 스케쥴바들에 이슈 링크 아이콘 추가 및 스케줄 원문 속성 보정
  setTimeout(function() {
    addIssueLinkIconsToExistingBars();
    if (typeof initializeScheduleNameAttributes === 'function') {
      initializeScheduleNameAttributes();
    }
  }, 200);
  
  // body에 클래스 추가로 전체 페이지 스크롤 제어
  $('body').addClass('timeline-view');
  
  // 오늘 날짜 위치로 스크롤
  var todayPosition = <%= today_position %>;
  var timelineContainer = $('.timeline-main');
  var containerWidth = timelineContainer.width();
  
  // 오늘이 화면 중앙에 오도록 스크롤
  var scrollLeft = Math.max(0, todayPosition - containerWidth * 0.2 );
  timelineContainer.scrollLeft(scrollLeft);

  // 스크롤 동기화 기능 초기화
  initializeScrollSync();

  // 날짜 헤더 드래그 스크롤 (delta 기반 - prepend 후에도 안정적)
  (function() {
    var isDragging = false;
    var lastX = 0;
    var $header = $('.timeline-header');
    var $main = $('.timeline-main');

    $header.on('mousedown', function(e) {
      isDragging = true;
      lastX = e.pageX;
      TL_VIEWPORT.isDraggingHeader = true;
      $header.addClass('dragging');
      e.preventDefault();
    });

    $(document).on('mousemove', function(e) {
      if (!isDragging) return;
      var deltaX = lastX - e.pageX;
      lastX = e.pageX;
      $main[0].scrollLeft += deltaX;
    });

    $(document).on('mouseup', function() {
      if (isDragging) {
        isDragging = false;
        TL_VIEWPORT.isDraggingHeader = false;
        $header.removeClass('dragging');
      }
    });
  })();

  // 타임라인 본문 드래그-스크롤 (읽기전용 모드에서만 활성)
  (function() {
    var isDragging = false;
    var lastX = 0;
    var lastY = 0;
    var $body = $('.timeline-body');
    var $main = $('.timeline-main');

    $body.on('mousedown', function(e) {
      // 스케줄 드로잉 모드: 좌클릭으로 드로잉 완료
      if (scheduleDrawing && scheduleDrawing.active) {
        if (e.button === 0) {
          e.preventDefault();
          finishScheduleDrawing(e);
        }
        return;
      }
      // 편집 모드: 프로젝트 바 위에서는 비활성 (드래그/리사이즈 보존)
      if (TL_STATE.isEditMode && ($(e.target).hasClass('project-bar') || $(e.target).closest('.project-bar').length > 0)) return;

      isDragging = true;
      lastX = e.pageX;
      lastY = e.pageY;
      $body.addClass('dragging-scroll');
      e.preventDefault();
    });

    $(document).on('mousemove', function(e) {
      if (!isDragging) return;
      var deltaX = lastX - e.pageX;
      var deltaY = lastY - e.pageY;
      lastX = e.pageX;
      lastY = e.pageY;
      $main[0].scrollLeft += deltaX;
      $body[0].scrollTop += deltaY;
    });

    $(document).on('mouseup', function() {
      if (isDragging) {
        isDragging = false;
        $body.removeClass('dragging-scroll');
      }
    });
  })();

  // 좌측 무한 스크롤: 좌측 끝 접근 시 과거 날짜 자동 로드
  (function() {
    var $main = $('.timeline-main');
    var scrollCooldown = false;
    $main.on('scroll', function() {
      if (this.scrollLeft < 100 && !TL_VIEWPORT.isLoading && !scrollCooldown) {
        scrollCooldown = true;
        prependTimelineDays(3);
        setTimeout(function() { scrollCooldown = false; }, 1000);
      }
    });
  })();

  // 이벤트 핸들러 등록
  registerEventHandlers();

  // 드래그 앤 드롭 기능 초기화
  initializeEventDragAndDrop();
  initializeCategoryDragAndDrop();
  
  // 드래그 기능 설정
  initializeProjectBarDraggable();

  // 편집 모드 토글 초기화
  var ignoreToggleChange = false;
  $('#editModeToggle').change(function() {
    if (ignoreToggleChange) return;
    var toggle = this;
    if (!toggle.checked && TL_STATE.isDirty) {
      // 편집 → 읽기 전환 시 저장되지 않은 변경사항 확인
      ignoreToggleChange = true;
      toggle.checked = true; // 일단 되돌리기
      ignoreToggleChange = false;
      showUnsavedChangesPopup(function onSave() {
        saveTimelineToServer(TL_STATE.currentTimelineName, true);
        ignoreToggleChange = true;
        toggle.checked = false;
        ignoreToggleChange = false;
        setEditMode(false);
      }, function onDiscard() {
        clearDirty();
        ignoreToggleChange = true;
        toggle.checked = false;
        ignoreToggleChange = false;
        setEditMode(false);
      });
      return;
    }
    setEditMode(toggle.checked);
  });
  setEditMode(false);

  // 저장되지 않은 변경사항 팝업 표시
  function showUnsavedChangesPopup(onSave, onDiscard) {
    var $popup = $('#unsavedChangesPopup');
    $popup.addClass('show');

    // 기존 핸들러 제거 후 새로 등록
    $('#unsavedCancelBtn').off('click').on('click', function() {
      $popup.removeClass('show');
    });
    $('#unsavedSaveBtn').off('click').on('click', function() {
      $popup.removeClass('show');
      if (onSave) onSave();
    });
    $('#unsavedDiscardBtn').off('click').on('click', function() {
      $popup.removeClass('show');
      if (onDiscard) onDiscard();
    });
  }

  // 페이지 이탈 시 경고
  $(window).on('beforeunload', function(e) {
    if (TL_STATE.isDirty) {
      e.preventDefault();
      return '저장되지 않은 변경사항이 있습니다. 페이지를 떠나시겠습니까?';
    }
  });

  // 초기 라인 높이 설정
  setTimeout(function() {
    updateLineHeight();
  }, 100);

  

  // ================================
  // 컨텍스트 메뉴 관련 함수
  // ================================

  // 컨텍스트 메뉴 표시
  function showContextMenu(e, mode) {
    var $menu = $('#tlContextMenu');
    // mode: 'empty' = 빈 셀, 'bar' = 스케줄 바
    $menu.find('[data-action="add-schedule"]').toggle(mode === 'empty');
    $menu.find('[data-action="edit-schedule"]').toggle(mode === 'bar');
    $menu.find('[data-action="delete-schedule"]').toggle(mode === 'bar');

    // 위치 계산 (뷰포트 밖으로 넘치면 보정)
    var x = e.clientX, y = e.clientY;
    $menu.addClass('show').css({ left: x, top: y });

    var menuW = $menu.outerWidth(), menuH = $menu.outerHeight();
    var winW = $(window).width(), winH = $(window).height();
    if (x + menuW > winW) $menu.css('left', winW - menuW - 4);
    if (y + menuH > winH) $menu.css('top', winH - menuH - 4);
  }

  function hideContextMenu() {
    $('#tlContextMenu').removeClass('show');
  }

  // ================================
  // 스케줄 드로잉 모드
  // ================================
  var scheduleDrawing = {
    active: false,
    startPixel: 0,
    startDayOffset: 0,
    timelineRow: null,
    previewBar: null,
    eventName: null,
    categoryName: null
  };

  function startScheduleDrawing() {
    if (!currentEditingSchedule) return;

    var clickedDate = currentEditingSchedule.clickedDate;
    var timelineRow = currentEditingSchedule.timelineRow;

    var startDateObj = parseLocalDate(clickedDate);
    var dayOffset = Math.round((startDateObj - TL_VIEWPORT.originDate) / 86400000);
    var startPixel = dayOffset * cellWidth;

    // 프리뷰 바 생성
    var $preview = $('<div class="schedule-preview-bar"><span class="schedule-preview-label"></span></div>');
    $preview.css({ left: startPixel + 'px', width: cellWidth + 'px' });
    timelineRow.append($preview);

    scheduleDrawing.active = true;
    scheduleDrawing.startPixel = startPixel;
    scheduleDrawing.startDayOffset = dayOffset;
    scheduleDrawing.timelineRow = timelineRow;
    scheduleDrawing.previewBar = $preview;
    scheduleDrawing.eventName = currentEditingSchedule.eventName;
    scheduleDrawing.categoryName = currentEditingSchedule.categoryName;

    $('body').addClass('schedule-drawing');
  }

  function updateScheduleDrawing(e) {
    if (!scheduleDrawing.active) return;

    var rowRect = scheduleDrawing.timelineRow[0].getBoundingClientRect();
    var mouseXInRow = e.clientX - rowRect.left;
    var currentPixel = Math.floor(mouseXInRow / cellWidth) * cellWidth;
    var startPixel = scheduleDrawing.startPixel;

    var left, width;
    if (currentPixel >= startPixel) {
      left = startPixel;
      width = currentPixel - startPixel + cellWidth;
    } else {
      left = currentPixel;
      width = startPixel - currentPixel + cellWidth;
    }

    var finalWidth = Math.max(width, cellWidth);
    scheduleDrawing.previewBar.css({
      left: left + 'px',
      width: finalWidth + 'px'
    });

    // 날짜 레이블 업데이트
    var actualStartOffset = Math.floor(left / cellWidth);
    var days = Math.round(finalWidth / cellWidth);
    var actualEndOffset = actualStartOffset + days - 1;
    var d1 = new Date(TL_VIEWPORT.originDate.getTime() + actualStartOffset * 86400000);
    var d2 = new Date(TL_VIEWPORT.originDate.getTime() + actualEndOffset * 86400000);
    var label = (d1.getMonth() + 1) + '/' + d1.getDate()
              + ' ~ ' + (d2.getMonth() + 1) + '/' + d2.getDate()
              + ' (' + days + '일)';
    scheduleDrawing.previewBar.find('.schedule-preview-label').text(label);
  }

  function finishScheduleDrawing(e) {
    if (!scheduleDrawing.active) return;

    var rowRect = scheduleDrawing.timelineRow[0].getBoundingClientRect();
    var mouseXInRow = e.clientX - rowRect.left;
    var endDayOffset = Math.floor(mouseXInRow / cellWidth);
    var startDayOffset = scheduleDrawing.startDayOffset;

    // start <= end 보장
    var actualStart = Math.min(startDayOffset, endDayOffset);
    var actualEnd = Math.max(startDayOffset, endDayOffset) + 1; // 종료일 미포함

    var startDate = new Date(TL_VIEWPORT.originDate.getTime() + actualStart * 86400000);
    var endDate = new Date(TL_VIEWPORT.originDate.getTime() + actualEnd * 86400000);

    currentEditingSchedule = {
      eventName: scheduleDrawing.eventName,
      categoryName: scheduleDrawing.categoryName,
      clickedDate: formatLocalDate(startDate),
      endDate: formatLocalDate(endDate),
      timelineRow: scheduleDrawing.timelineRow
    };

    cancelScheduleDrawing();
    openScheduleAddPopup();
  }

  function cancelScheduleDrawing() {
    if (!scheduleDrawing.active) return;

    if (scheduleDrawing.previewBar) {
      scheduleDrawing.previewBar.remove();
    }
    scheduleDrawing.active = false;
    scheduleDrawing.timelineRow = null;
    scheduleDrawing.previewBar = null;

    $('body').removeClass('schedule-drawing');
  }

  // 드로잉 중 마우스 이동
  $(document).on('mousemove', function(e) {
    updateScheduleDrawing(e);
  });

  // 스케줄 추가 팝업 열기 (currentEditingSchedule 사용)
  function openScheduleAddPopup() {
    if (!currentEditingSchedule) return;

    var eventName = currentEditingSchedule.eventName;
    var categoryName = currentEditingSchedule.categoryName;
    var clickedDate = currentEditingSchedule.clickedDate;

    // 팝업에 정보 설정
    $('#scheduleEventName').text(eventName);
    $('#scheduleCategoryName').text('(' + categoryName + ')');

    // 폼 초기화
    $('#scheduleName').val('');
    $('#scheduleStartDate').val(clickedDate);

    // 종료일: 드로잉으로 지정된 날짜가 있으면 사용, 없으면 1주일 뒤
    if (currentEditingSchedule.endDate) {
      $('#scheduleEndDate').val(currentEditingSchedule.endDate);
    } else {
      var startDateObj = new Date(clickedDate);
      var endDateObj = new Date(startDateObj);
      endDateObj.setDate(endDateObj.getDate() + 6);
      var endDateString = endDateObj.toISOString().split('T')[0];
      $('#scheduleEndDate').val(endDateString);
    }

    $('#scheduleIssue').val('');

    // 팝업 표시
    $('#schedulePopup').addClass('show');

    setTimeout(function() {
      $('#scheduleName').focus();
    }, 100);
  }

  // 스케줄 편집 팝업 열기 (currentEditingScheduleBar 사용)
  function openScheduleEditPopup() {
    if (!currentEditingScheduleBar) return;

    var scheduleBar = currentEditingScheduleBar.element;
    var eventName = currentEditingScheduleBar.eventName;
    var categoryName = currentEditingScheduleBar.categoryName;
    var scheduleName = currentEditingScheduleBar.scheduleName;

    // 팝업에 정보 설정
    $('#scheduleEditEventName').text(eventName);
    $('#scheduleEditCategoryName').text('(' + categoryName + ')');
    $('#scheduleEditName').val(scheduleName);

    // 스케줄 바의 위치와 크기로부터 날짜 정보 계산
    var startDate = null;
    var endDate = null;

    var title = scheduleBar.attr('title') || '';
    var dateMatch = title.match(/\((\d{4}-\d{2}-\d{2}) ~ (\d{4}-\d{2}-\d{2})\)/);

    if (dateMatch) {
      startDate = dateMatch[1];
      endDate = dateMatch[2];
    } else {
      var barLeft = parseInt(scheduleBar.css('left')) || 0;
      var barWidth = scheduleBar.width() || cellWidth;
      var startDateObj = new Date(TL_VIEWPORT.originDate.getTime());

      var startDayOffset = Math.floor(barLeft / cellWidth);
      var calculatedStartDate = new Date(startDateObj.getTime() + (startDayOffset * 24 * 60 * 60 * 1000));

      var durationDays = Math.ceil(barWidth / cellWidth);
      var calculatedEndDate = new Date(calculatedStartDate.getTime() + (durationDays * 24 * 60 * 60 * 1000));

      startDate = formatLocalDate(calculatedStartDate);
      endDate = formatLocalDate(calculatedEndDate);
    }

    $('#scheduleEditStartDate').val(startDate);
    $('#scheduleEditEndDate').val(endDate);

    var issueNumber = scheduleBar.attr('data-issue-number') || '';
    $('#scheduleEditIssue').val(issueNumber);

    var scheduleKey = eventName + '_' + currentEditingScheduleBar.scheduleIndex;
    var currentScheduleColor = scheduleColors[scheduleKey] || null;

    initializeScheduleColorPicker(currentScheduleColor, categoryName);

    $('#scheduleEditPopup').addClass('show');

    setTimeout(function() {
      $('#scheduleEditName').focus().select();
    }, 100);
  }

  // 현재 스케줄 삭제
  function deleteCurrentSchedule() {
    if (!currentEditingScheduleBar) return;

    var scheduleName = currentEditingScheduleBar.scheduleName;
    var eventName = currentEditingScheduleBar.eventName;
    var categoryName = currentEditingScheduleBar.categoryName;

    if (confirm('정말로 "' + scheduleName + '" 스케줄을 삭제하시겠습니까?')) {
      console.log('스케줄 삭제:', scheduleName);

      currentEditingScheduleBar.element.remove();
      updateProjectInfo(eventName, categoryName);
      markDirty();

      if ($('#scheduleEditPopup').hasClass('show')) {
        hideScheduleEditPopup();
      } else {
        currentEditingScheduleBar = null;
      }
    }
  }

  // 컨텍스트 메뉴 항목 클릭 핸들러
  $(document).on('click', '.tl-context-menu-item', function() {
    var action = $(this).data('action');
    hideContextMenu();

    if (action === 'add-schedule') {
      startScheduleDrawing();
    } else if (action === 'edit-schedule') {
      openScheduleEditPopup();
    } else if (action === 'delete-schedule') {
      deleteCurrentSchedule();
    }
  });

  // 빈 셀 우클릭 컨텍스트 메뉴
  $(document).on('contextmenu', '.timeline-row', function(e) {
    if (scheduleDrawing && scheduleDrawing.active) {
      e.preventDefault();
      cancelScheduleDrawing();
      return;
    }
    if (!TL_STATE.isEditMode) return;

    // 프로젝트 바 위에서는 무시 (별도 핸들러에서 처리)
    if ($(e.target).hasClass('project-bar') || $(e.target).closest('.project-bar').length > 0) return;

    // 카테고리 행은 무시
    if ($(this).hasClass('category-row')) return;

    e.preventDefault();
    e.stopPropagation();

    // 클릭 위치에서 해당하는 셀 찾기
    var clickedCell = null;

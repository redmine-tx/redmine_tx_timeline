<script>

function replaceObjectContents(target, source) {
  Object.keys(target).forEach(function(key) {
    delete target[key];
  });

  Object.keys(source).forEach(function(key) {
    target[key] = source[key];
  });

  return target;
}

function ensureTimelineState() {
  if (!TL_STATE.timeline) {
    TL_STATE.timeline = {
      metadata: {
        name: currentTimelineName || 'Default',
        version: '1.0',
        description: 'Redmine 타임라인 데이터'
      },
      options: {},
      categories: []
    };
  }

  if (!TL_STATE.ui) {
    TL_STATE.ui = {
      collapsedCategoryIds: {}
    };
  }

  if (!TL_STATE.ui.collapsedCategoryIds) {
    TL_STATE.ui.collapsedCategoryIds = {};
  }

  return TL_STATE.timeline;
}

function cloneTimelineEntity(entity) {
  return $.extend({}, entity || {});
}

function nextTimelineEntityId(prefix) {
  TL_STATE.idSequence = (TL_STATE.idSequence || 0) + 1;
  return prefix + '_' + Date.now().toString(36) + '_' + TL_STATE.idSequence.toString(36);
}

function normalizeDateValue(value) {
  if (!value) return null;
  if (value instanceof Date) return formatLocalDate(value);
  if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) return value;

  var parsed = new Date(value);
  if (isNaN(parsed.getTime())) return null;
  return formatLocalDate(parsed);
}

function normalizeScheduleData(scheduleData) {
  var normalized = cloneTimelineEntity(scheduleData);
  normalized.id = normalized.id || nextTimelineEntityId('schedule');
  normalized.name = normalized.name || '일정 없음';
  normalized.startDate = normalizeDateValue(normalized.startDate || normalized.start_date);
  normalized.endDate = normalizeDateValue(normalized.endDate || normalized.end_date);
  normalized.issue = normalized.issue || '';
  if (normalized.doneRatio === undefined) {
    normalized.doneRatio = normalized.done_ratio !== undefined ? normalized.done_ratio : null;
  }
  delete normalized.start_date;
  delete normalized.end_date;
  delete normalized.done_ratio;
  return normalized;
}

function normalizeEventData(eventData) {
  var normalized = cloneTimelineEntity(eventData);
  normalized.id = normalized.id || nextTimelineEntityId('event');
  normalized.name = normalized.name || '이름 없음';
  normalized.schedules = Array.isArray(eventData && eventData.schedules) ?
    eventData.schedules.map(normalizeScheduleData) : [];
  return normalized;
}

function normalizeCategoryData(categoryData) {
  var normalized = cloneTimelineEntity(categoryData);
  normalized.id = normalized.id || nextTimelineEntityId('category');
  normalized.name = normalized.name || '미분류';
  normalized.events = Array.isArray(categoryData && categoryData.events) ?
    categoryData.events.map(normalizeEventData) : [];
  return normalized;
}

function normalizeTimelineData(importData) {
  var timelineData = importData || {};
  var metadata = cloneTimelineEntity(timelineData.metadata);
  var options = cloneTimelineEntity(timelineData.options);

  metadata.name = metadata.name || currentTimelineName || 'Default';
  metadata.version = metadata.version || '1.0';
  metadata.description = metadata.description || 'Redmine 타임라인 데이터';

  return {
    metadata: metadata,
    options: options,
    categories: Array.isArray(timelineData.categories) ?
      timelineData.categories.map(normalizeCategoryData) : []
  };
}

function rebuildColorCachesFromState() {
  ensureTimelineState();

  var nextCategoryColors = {};
  var nextScheduleColors = {};

  TL_STATE.timeline.categories.forEach(function(category) {
    if (category.customColor) {
      nextCategoryColors[category.id] = category.customColor;
    }

    category.events.forEach(function(eventData) {
      eventData.schedules.forEach(function(schedule) {
        if (schedule.customColor) {
          nextScheduleColors[schedule.id] = schedule.customColor;
        }
      });
    });
  });

  replaceObjectContents(TL_STATE.colors.category, nextCategoryColors);
  replaceObjectContents(TL_STATE.colors.schedule, nextScheduleColors);
  categoryColors = TL_STATE.colors.category;
  scheduleColors = TL_STATE.colors.schedule;
}

function setTimelineState(importData) {
  var previousCollapsed = (TL_STATE.ui && TL_STATE.ui.collapsedCategoryIds) || {};
  TL_STATE.timeline = normalizeTimelineData(importData);
  TL_STATE.currentTimelineName = TL_STATE.timeline.metadata.name || 'Default';
  currentTimelineName = TL_STATE.currentTimelineName;

  rebuildColorCachesFromState();

  var nextCollapsed = {};
  TL_STATE.timeline.categories.forEach(function(category) {
    if (previousCollapsed[category.id]) {
      nextCollapsed[category.id] = true;
    }
  });
  TL_STATE.ui.collapsedCategoryIds = nextCollapsed;

  return TL_STATE.timeline;
}

function serializeTimelineState(name, options) {
  var includeTimeline = options && options.includeTimeline;
  var timeline = ensureTimelineState();
  var metadata = cloneTimelineEntity(timeline.metadata);

  metadata.exportDate = new Date().toISOString();
  metadata.name = name || metadata.name || currentTimelineName || 'Default';
  metadata.version = metadata.version || '1.0';
  metadata.description = metadata.description || 'Redmine 타임라인 데이터';

  var jsonData = {
    metadata: metadata,
    categories: timeline.categories.map(function(category, categoryIndex) {
      var categoryData = cloneTimelineEntity(category);
      categoryData.index = categoryIndex;
      categoryData.events = category.events.map(function(eventData) {
        var serializedEvent = cloneTimelineEntity(eventData);
        serializedEvent.schedules = eventData.schedules.map(function(schedule) {
          return cloneTimelineEntity(schedule);
        });
        return serializedEvent;
      });
      return categoryData;
    })
  };

  if (includeTimeline) {
    jsonData.options = cloneTimelineEntity(timeline.options);
    jsonData.options.startDate = formatLocalDate(TL_VIEWPORT.originDate);
    jsonData.options.endDate = formatLocalDate(TL_VIEWPORT.endDate);
  }

  return jsonData;
}

function findCategoryById(categoryId) {
  if (!categoryId) return null;
  return ensureTimelineState().categories.find(function(category) {
    return category.id === categoryId;
  }) || null;
}

function findCategoryContextById(categoryId) {
  var categories = ensureTimelineState().categories;
  for (var i = 0; i < categories.length; i++) {
    if (categories[i].id === categoryId) {
      return {
        category: categories[i],
        categoryIndex: i
      };
    }
  }
  return null;
}

function findEventContextById(eventId) {
  if (!eventId) return null;

  var categories = ensureTimelineState().categories;
  for (var i = 0; i < categories.length; i++) {
    var category = categories[i];
    for (var j = 0; j < category.events.length; j++) {
      if (category.events[j].id === eventId) {
        return {
          category: category,
          categoryIndex: i,
          event: category.events[j],
          eventIndex: j
        };
      }
    }
  }

  return null;
}

function findScheduleContextById(scheduleId) {
  if (!scheduleId) return null;

  var categories = ensureTimelineState().categories;
  for (var i = 0; i < categories.length; i++) {
    var category = categories[i];
    for (var j = 0; j < category.events.length; j++) {
      var eventData = category.events[j];
      for (var k = 0; k < eventData.schedules.length; k++) {
        if (eventData.schedules[k].id === scheduleId) {
          return {
            category: category,
            categoryIndex: i,
            event: eventData,
            eventIndex: j,
            schedule: eventData.schedules[k],
            scheduleIndex: k
          };
        }
      }
    }
  }

  return null;
}

function getCategoryColor(categoryRef) {
  if (!categoryRef) return null;

  if (typeof categoryRef === 'object') {
    if (categoryRef.customColor) return categoryRef.customColor;
    if (categoryRef.id) return getCategoryColor(categoryRef.id);
  }

  var byId = findCategoryById(categoryRef);
  if (byId) {
    return byId.customColor || null;
  }

  var categories = ensureTimelineState().categories;
  for (var i = 0; i < categories.length; i++) {
    if (categories[i].name === categoryRef) {
      return categories[i].customColor || null;
    }
  }

  return categoryColors[categoryRef] || null;
}

function getScheduleColor(scheduleRef) {
  if (!scheduleRef) return null;

  if (typeof scheduleRef === 'object') {
    if (scheduleRef.customColor) return scheduleRef.customColor;
    if (scheduleRef.id) return getScheduleColor(scheduleRef.id);
  }

  var context = findScheduleContextById(scheduleRef);
  if (context) {
    return context.schedule.customColor || null;
  }

  return scheduleColors[scheduleRef] || null;
}

function isCategoryCollapsed(categoryId) {
  ensureTimelineState();
  return !!TL_STATE.ui.collapsedCategoryIds[categoryId];
}

function setCategoryCollapsed(categoryId, collapsed) {
  ensureTimelineState();
  if (collapsed) {
    TL_STATE.ui.collapsedCategoryIds[categoryId] = true;
  } else {
    delete TL_STATE.ui.collapsedCategoryIds[categoryId];
  }
}

function updateSidebarProjectInfo($projectBar, dates) {
  var eventId = $projectBar.attr('data-event-id');
  if (!eventId) return;

  var context = findEventContextById(eventId);
  if (!context) return;

  var info = context.event.schedules.length + '개 스케줄';
  $('.project-item[data-event-id="' + eventId + '"]').find('.project-info').text(info);
}

  // 프로젝트 날짜 계산 함수 (드래그용)
  function calculateProjectDates($projectBar, leftPosition) {
    var startDate = new Date(TL_VIEWPORT.originDate.getTime());
    var daysOffset = Math.floor(leftPosition / cellWidth); // 바닥함수로 셀 시작점 기준 계산
    
    // 시작일 계산
    var projectStartDate = new Date(startDate.getTime() + (daysOffset * 24 * 60 * 60 * 1000));
    
    // 프로젝트 기간 계산 (바의 너비 기준)
    var durationDays = Math.round($projectBar.width() / cellWidth); // 너비는 반올림 사용
    var projectEndDate = new Date(projectStartDate.getTime() + (durationDays * 24 * 60 * 60 * 1000));  // 종료일 미포함 방식
    
    return {
      startDate: projectStartDate,
      endDate: projectEndDate
    };
  }

  // 프로젝트 날짜 계산 함수 (리사이즈용)
  function calculateProjectDatesFromResize($projectBar, leftPosition, width) {
    var startDate = new Date(TL_VIEWPORT.originDate.getTime());
    var daysOffset = Math.floor(leftPosition / cellWidth); // 바닥함수로 셀 시작점 기준 계산
    
    // 시작일 계산
    var projectStartDate = new Date(startDate.getTime() + (daysOffset * 24 * 60 * 60 * 1000));
    
    // 프로젝트 기간 계산 (리사이즈된 너비 기준)
    var durationDays = Math.round(width / cellWidth); // 너비는 반올림 사용
    var projectEndDate = new Date(projectStartDate.getTime() + (durationDays * 24 * 60 * 60 * 1000));  // 종료일 미포함 방식

    return {
      startDate: projectStartDate,
      endDate: projectEndDate
    };
  }

// 드래그 중 날짜 표시 업데이트
function updateProjectDates($projectBar, leftPosition) {
  var dates = calculateProjectDates($projectBar, leftPosition);
  
  // 현지 시간대 기준으로 YYYY-MM-DD 형식 변환
  var startDateStr = formatLocalDate(dates.startDate);
  var endDateStr = formatLocalDate(dates.endDate);
  
  $projectBar.attr('title', 
    $projectBar.text() + ' (' + startDateStr + ' ~ ' + endDateStr + ')'
  );
}

// 리사이즈 중 날짜 표시 업데이트
function updateProjectDatesFromResize($projectBar, leftPosition, width) {
  var dates = calculateProjectDatesFromResize($projectBar, leftPosition, width);
  
  // 현지 시간대 기준으로 YYYY-MM-DD 형식 변환
  var startDateStr = formatLocalDate(dates.startDate);
  var endDateStr = formatLocalDate(dates.endDate);
  
  $projectBar.attr('title', 
    $projectBar.text() + ' (' + startDateStr + ' ~ ' + endDateStr + ')'
  );
}

// 날짜를 현지 시간대 기준 YYYY-MM-DD 형식으로 변환하는 헬퍼 함수
function formatLocalDate(date) {
  var year = date.getFullYear();
  var month = ('0' + (date.getMonth() + 1)).slice(-2);
  var day = ('0' + date.getDate()).slice(-2);
  return year + '-' + month + '-' + day;
}

// YYYY-MM-DD 문자열을 현지 시간대 기준 Date 객체로 변환하는 헬퍼 함수
function parseLocalDate(dateString) {
  var parts = dateString.split('-');
  if (parts.length !== 3) {
    return new Date(dateString); // fallback
  }
  // 현지 시간대로 파싱 (UTC가 아닌)
  return new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
}

// ============================================================
// 동적 셀/헤더 생성 함수 (TL_VIEWPORT 기반)
// ============================================================

// 카테고리 행용 셀 HTML 생성 (data-date 없음)
function generateCategoryCellsHtml(numDays) {
  var html = '';
  var w = TL_VIEWPORT.cellWidth;
  for (var i = 0; i < numDays; i++) {
    html += '<div class="timeline-cell" style="width: ' + w + 'px;"></div>';
  }
  return html;
}

// 이벤트 행용 셀 HTML 생성 (data-date + schedule-add-target 포함)
function generateEventCellsHtml(startDate, numDays) {
  var html = '';
  var w = TL_VIEWPORT.cellWidth;
  var currentDate = new Date(startDate.getTime());
  for (var i = 0; i < numDays; i++) {
    var dateStr = formatLocalDate(currentDate);
    html += '<div class="timeline-cell schedule-add-target" style="width: ' + w + 'px;" data-date="' + dateStr + '"></div>';
    currentDate.setDate(currentDate.getDate() + 1);
  }
  return html;
}

// 일(day) 헤더 셀 HTML 생성
function generateDayHeaderHtml(startDate, numDays) {
  var html = '';
  var w = TL_VIEWPORT.cellWidth;
  var currentDate = new Date(startDate.getTime());
  for (var i = 0; i < numDays; i++) {
    var wday = currentDate.getDay();
    var weekendClass = '';
    if (wday === 0) weekendClass = 'sunday';
    else if (wday === 6) weekendClass = 'saturday';
    html += '<div class="day-cell ' + weekendClass + '" style="width: ' + w + 'px;">' + currentDate.getDate() + '</div>';
    currentDate.setDate(currentDate.getDate() + 1);
  }
  return html;
}

// 월(month) 헤더 셀 HTML 생성
function generateMonthHeaderHtml(startDate, endDate) {
  var html = '';
  var w = TL_VIEWPORT.cellWidth;
  var currentMonth = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
  while (currentMonth <= endDate) {
    var year = currentMonth.getFullYear();
    var month = currentMonth.getMonth();
    var monthStart = new Date(year, month, 1);
    var monthEnd = new Date(year, month + 1, 0); // last day of month
    var visibleStart = monthStart < startDate ? startDate : monthStart;
    var visibleEnd = monthEnd > endDate ? endDate : monthEnd;
    var visibleDays = Math.round((visibleEnd - visibleStart) / (1000 * 60 * 60 * 24)) + 1;
    if (visibleDays > 0) {
      var width = visibleDays * w;
      var label = year + '년 ' + ('0' + (month + 1)).slice(-2) + '월';
      html += '<div class="month-cell" style="width: ' + width + 'px;">' + label + '</div>';
    }
    currentMonth.setMonth(currentMonth.getMonth() + 1);
  }
  return html;
}

// 날짜 구분선(grid line) HTML 생성
function generateGridLinesHtml(startDate, numDays, pixelOffset) {
  var html = '';
  var w = TL_VIEWPORT.cellWidth;
  var currentDate = new Date(startDate.getTime());
  for (var i = 0; i < numDays; i++) {
    var mondayClass = currentDate.getDay() === 1 ? 'monday-line' : '';
    var left = pixelOffset + i * w;
    html += '<div class="date-grid-line ' + mondayClass + '" style="left: ' + left + 'px;"></div>';
    currentDate.setDate(currentDate.getDate() + 1);
  }
  return html;
}

// 모든 타임라인 데이터 삭제 함수
  function clearAllTimelineData() {
    console.log('기존 타임라인 데이터 삭제 시작');
    
    // 타임라인 행들 삭제 (오늘 표시선 제외)
    $('.timeline-row').remove();
    
    // 사이드바 카테고리와 프로젝트 삭제
    $('.category-header, .project-item').remove();
    
    console.log('기존 타임라인 데이터 삭제 완료');
  }

  // 카테고리 헤더 DOM 요소 생성 (XSS-safe)
  function createCategoryHeaderElement(categoryData, categoryIndex) {
    var $header = $('<div class="category-header">').attr({
      'data-category-id': categoryData.id,
      'data-category-index': categoryIndex
    });
    var $left = $('<div class="category-left">');
    var collapsed = isCategoryCollapsed(categoryData.id);
    $left.append($('<button class="category-toggle-btn" type="button">').text(collapsed ? '▶' : '▼'));
    $left.append($('<span class="category-title">').text(categoryData.name));
    $header.append($left);
    var $actions = $('<div class="category-actions">');
    $actions.append($('<button class="category-btn add-event-btn" type="button" title="이벤트 추가">').text('+'));
    $actions.append($('<button class="category-btn edit-category-btn" type="button" title="편집">').text('✏'));
    $actions.append($('<button class="category-btn delete-category-btn" type="button" title="카테고리 삭제">').text('×'));
    $actions.appendTo($header);
    if (collapsed) {
      $header.addClass('category-collapsed');
      $header.find('.category-toggle-btn').addClass('collapsed');
    }
    return $header;
  }

  // 이벤트 항목 DOM 요소 생성 (XSS-safe)
  function createEventItemElement(categoryData, eventData, categoryIndex) {
    var $item = $('<div class="project-item">').attr({
      'data-category-id': categoryData.id,
      'data-event-id': eventData.id,
      'data-category-index': categoryIndex
    });
    var $content = $('<div class="event-content">');
    $content.append($('<div class="project-name">').text(eventData.name));
    $content.append($('<div class="project-info">').text(eventData.schedules.length + '개 스케줄'));
    $item.append($content);
    var $editForm = $('<form class="event-edit-form">');
    $editForm.append($('<textarea class="event-edit-input">').text(eventData.name));
    $item.append($editForm);
    var $actions = $('<div class="event-actions">');
    $actions.append($('<button class="event-btn edit-event-btn" title="편집">').text('✏️'));
    $actions.append($('<button class="event-btn delete-event-btn" title="삭제">').text('🗑️'));
    $item.append($actions);
    var $editActions = $('<div class="event-edit-actions">');
    $editActions.append($('<button class="event-btn save-event-btn" title="저장">').text('✓'));
    $editActions.append($('<button class="event-btn cancel-event-btn" title="취소">').text('✕'));
    $item.append($editActions);
    return $item;
  }

  // 스케줄 바 DOM 요소 생성 (XSS-safe)
  function createScheduleBarElement(barClass, barStyle, scheduleData, scheduleIndex, eventId) {
    var scheduleName = scheduleData.name || '일정 없음';
    var startDateStr = scheduleData.startDate;
    var endDateStr = scheduleData.endDate;
    var issueNumber = scheduleData.issue;
    var doneRatio = scheduleData.doneRatio;
    var displayName = scheduleName.length > 20 ? scheduleName.substring(0, 20) + '...' : scheduleName;
    if (doneRatio !== null && doneRatio !== undefined && doneRatio !== '') {
      displayName += ' (' + doneRatio + '%)';
    }
    var titleText = scheduleName + ' (' + startDateStr + ' ~ ' + endDateStr + ')';

    var $bar = $('<div>').addClass(barClass).attr({
      'style': barStyle,
      'title': titleText,
      'data-schedule-id': scheduleData.id,
      'data-event-id': eventId || '',
      'data-schedule-index': scheduleIndex,
      'data-issue-number': issueNumber || '',
      'data-done-ratio': doneRatio || '',
      'data-schedule-name': scheduleName
    });
    $bar.append($('<span class="project-bar-text">').text(displayName));
    var $icon = generateIssueLinkElement(issueNumber);
    if ($icon) $bar.append($icon);
    return $bar;
  }

function renderTimelineFromState() {
  var timeline = ensureTimelineState();
  clearAllTimelineData();

  timeline.categories.forEach(function(categoryData, categoryIndex) {
    var collapsed = isCategoryCollapsed(categoryData.id);
    var $categoryHeader = createCategoryHeaderElement(categoryData, categoryIndex);
    $('.sidebar-content').append($categoryHeader);

    var $categoryRow = $('<div class="timeline-row category-row">').attr({
      'data-category-id': categoryData.id,
      'data-category-name': categoryData.name
    });
    $categoryRow.append($('<div class="timeline-grid">').html(generateCategoryCellsHtml(TL_VIEWPORT.totalDays)));
    $('.timeline-body').append($categoryRow);

    categoryData.events.forEach(function(eventData) {
      var $eventItem = createEventItemElement(categoryData, eventData, categoryIndex);
      var $eventRow = $('<div class="timeline-row">').attr({
        'data-category-id': categoryData.id,
        'data-event-id': eventData.id,
        'data-event-name': eventData.name,
        'data-category-name': categoryData.name
      });
      $eventRow.append($('<div class="timeline-grid">').html(generateEventCellsHtml(TL_VIEWPORT.originDate, TL_VIEWPORT.totalDays)));

      eventData.schedules.forEach(function(scheduleData, scheduleIndex) {
        if (!scheduleData.startDate || !scheduleData.endDate) return;

        var scheduleStartDate = parseLocalDate(scheduleData.startDate);
        var scheduleEndDate = parseLocalDate(scheduleData.endDate);
        var projectStartDays = Math.round((scheduleStartDate - TL_VIEWPORT.originDate) / 86400000);
        var projectDurationDays = Math.round((scheduleEndDate - scheduleStartDate) / 86400000);
        var barLeft = projectStartDays * <%= cell_width %>;
        var barWidth = projectDurationDays * <%= cell_width %>;
        var appliedColor = scheduleData.customColor || categoryData.customColor;
        var barClass = appliedColor ? 'project-bar custom-color' : 'project-bar issue-' + scheduleData.issue;
        var barStyle = 'position: absolute; top: 2px; left: ' + barLeft + 'px; width: ' + barWidth + 'px; z-index: ' + (101 + scheduleIndex) + ';';

        if (appliedColor) {
          barStyle += ' background-color: ' + appliedColor + ';';
        }

        $eventRow.append(createScheduleBarElement(barClass, barStyle, scheduleData, scheduleIndex, eventData.id));
      });

      if (collapsed) {
        $eventItem.addClass('hidden');
        $eventRow.addClass('hidden');
      }

      $('.sidebar-content').append($eventItem);
      $('.timeline-body').append($eventRow);
    });
  });

  initializeProjectBarDraggable();
  setTimeout(function() {
    updateLineHeight();
  }, 100);
}

function applyImportedData(importData) {
  console.log('불러온 데이터 적용 시작');
  setTimelineState(importData);
  renderTimelineFromState();
  console.log('불러온 데이터 적용 완료');
}

  // 이슈 링크 아이콘 HTML 생성 함수 (하위 호환용 - 레거시 코드에서 사용)
  function generateIssueLinkIcon(issueNumber) {
    if (!issueNumber || String(issueNumber).trim() === '') {
      return '';
    }
    var $el = generateIssueLinkElement(issueNumber);
    return $el ? $el.prop('outerHTML') : '';
  }

  // 이슈 링크 아이콘 DOM 요소 생성 (XSS-safe)
  function generateIssueLinkElement(issueNumber) {
    if (!issueNumber || String(issueNumber).trim() === '') {
      return null;
    }
    var $link = $('<a class="issue-link-icon" target="_blank">').attr({
      'href': '/issues/' + encodeURIComponent(issueNumber),
      'data-issue-tooltip': issueNumber
    });
    $link.append($('<span class="issue-link-symbol">').text('🔗'));
    return $link;
  }

  // 기존 스케쥴바들에 이슈 링크 아이콘 추가하는 함수
  function addIssueLinkIconsToExistingBars() {
    $('.project-bar').each(function() {
      var $bar = $(this);
      var issueNumber = $bar.attr('data-issue-number');
      
      // 이미 이슈 링크 아이콘이 있거나 이슈 번호가 없으면 스킵
      if ($bar.find('.issue-link-icon').length > 0 || !issueNumber || issueNumber.trim() === '') {
        return;
      }
      
      // 공통 함수를 사용하여 이슈 링크 아이콘 추가
      var issueLinkIcon = generateIssueLinkIcon(issueNumber);
      $bar.append(issueLinkIcon);
    });
  }

  // 기존 스케줄 바들에 원문 스케줄명 속성 보정 함수
  function initializeScheduleNameAttributes() {
    $('.project-bar').each(function() {
      var $bar = $(this);
      // 이미 원문 속성이 있으면 유지
      var originalName = $bar.attr('data-schedule-name');
      if (originalName && originalName.trim() !== '') {
        return;
      }
      // title에서 이름 부분만 추출 시도: "이름 (YYYY-MM-DD ~ YYYY-MM-DD)"
      var title = $bar.attr('title') || '';
      var match = title.match(/^(.*) \(\d{4}-\d{2}-\d{2} ~ \d{4}-\d{2}-\d{2}\)$/);
      if (match && match[1]) {
        $bar.attr('data-schedule-name', match[1]);
        return;
      }
      // fallback: 표시 텍스트 사용 (…일 수 있음)
      var displayText = $bar.find('.project-bar-text').text().trim();
      if (displayText) {
        $bar.attr('data-schedule-name', displayText);
      }
    });
  }


// 특정 행의 프로젝트 바 드래그/리사이즈 기능 초기화
  function initializeProjectBarDraggableForRow($row) {
    if (!$row || $row.length === 0) return;
    
    var $projectBars = $row.find('.project-bar');
    console.log('새 행의 프로젝트 바 개수:', $projectBars.length);
    
    // 각 프로젝트 바에 z-index 재설정 (혹시 누락된 경우)
    $projectBars.each(function(index) {
      var $bar = $(this);
      if (!$bar.data('schedule-index')) {
        $bar.attr('data-schedule-index', index);
      }
      
      // z-index가 인라인 스타일에 없으면 추가
      var currentStyle = $bar.attr('style') || '';
      if (currentStyle.indexOf('z-index') === -1) {
        var zIndex = 101 + index;
        $bar.attr('style', currentStyle + '; z-index: ' + zIndex + ';');
      }
    });
    
    applyDraggableToElements($projectBars);
  }

  // 프로젝트 바 드래그 및 리사이즈 기능 초기화
  function initializeProjectBarDraggable() {
    // 기존 드래그/리사이즈 기능 제거 (이미 초기화된 것들만)
    $('.project-bar').each(function() {
      if ($(this).hasClass('ui-draggable')) {
        $(this).draggable('destroy');
      }
      if ($(this).hasClass('ui-resizable')) {
        $(this).resizable('destroy');
      }
    });
    
    // 모든 프로젝트 바에 드래그/리사이즈 기능 적용
    applyDraggableToElements($('.project-bar'));
  }

  // 바의 중심 Y 좌표로 대상 이벤트 행을 찾음 (카테고리 행 제외)
  function findTargetTimelineRow(barCenterY) {
    var $tb = $('.timeline-body');
    var tbOffset = $tb.offset().top;
    var tbScroll = $tb.scrollTop();
    var result = null;

    $('.timeline-row').not('.category-row').each(function() {
      var $row = $(this);
      var rowTop = $row.offset().top - tbOffset + tbScroll;
      var rowBottom = rowTop + $row.outerHeight();
      if (barCenterY >= rowTop && barCenterY < rowBottom) {
        result = $row;
        return false;
      }
    });
    return result;
  }

  // 스케줄 바를 다른 행으로 이동 + 양쪽 사이드바 정보 갱신
  function moveScheduleBarToRow($bar, $sourceRow, $targetRow, finalDates) {
    var scheduleId = $bar.data('schedule-id');
    var targetEventId = $targetRow.data('event-id');
    if (!scheduleId || !targetEventId) return;

    var scheduleContext = findScheduleContextById(scheduleId);
    var targetEventContext = findEventContextById(targetEventId);
    if (!scheduleContext || !targetEventContext) return;

    var schedule = scheduleContext.schedule;
    if (finalDates) {
      schedule.startDate = formatLocalDate(finalDates.startDate);
      schedule.endDate = formatLocalDate(finalDates.endDate);
    }
    scheduleContext.event.schedules.splice(scheduleContext.scheduleIndex, 1);
    targetEventContext.event.schedules.push(schedule);

    rebuildColorCachesFromState();
    renderTimelineFromState();
    markDirty();
  }

  // 프로젝트 바 요소들에 드래그/리사이즈 기능 적용
  function applyDraggableToElements($elements) {
    if (!$elements || $elements.length === 0) return;

    console.log('드래그/리사이즈 기능 적용 대상:', $elements.length, '개 요소');

    // 리사이즈 기능 추가 (양쪽 끝 드래그로 크기 조정)
    $elements.resizable({
      handles: 'e, w', // 동쪽(우측), 서쪽(좌측) 핸들만 활성화
      grid: [<%= cell_width %>, 0], // 일 단위로 스냅
      minWidth: <%= cell_width %>, // 최소 1일 크기
      containment: '.timeline-body',
      start: function(event, ui) {
        $(this).addClass('ui-resizable-resizing');
        // 리사이즈 시작 위치와 크기 저장
        $(this).data('startLeft', ui.position.left);
        $(this).data('startWidth', ui.size.width);
      },
      resize: function(event, ui) {
        // 리사이즈 중 날짜 업데이트
        updateProjectDatesFromResize($(this), ui.position.left, ui.size.width);
      },
      stop: function(event, ui) {
        $(this).removeClass('ui-resizable-resizing');

        // 최종 크기와 위치에서의 날짜 계산 및 업데이트
        var finalDates = calculateProjectDatesFromResize($(this), ui.position.left, ui.size.width);
        var scheduleId = $(this).data('schedule-id');

        console.log('프로젝트 리사이즈 완료:', {
          id: scheduleId,
          startDate: finalDates.startDate,
          endDate: finalDates.endDate
        });

        var scheduleContext = findScheduleContextById(scheduleId);
        if (scheduleContext) {
          scheduleContext.schedule.startDate = formatLocalDate(finalDates.startDate);
          scheduleContext.schedule.endDate = formatLocalDate(finalDates.endDate);
          rebuildColorCachesFromState();
          renderTimelineFromState();
        }

        markDirty();
      }
    });

    // 드래그 기능 추가 (중앙 부분 드래그로 이동, 위아래 자유 이동 허용)
    $elements.draggable({
      grid: [<%= cell_width %>, 1], // X는 날짜 스냅, Y는 자유
      containment: '.timeline-body', // 타임라인 영역 내에서만 드래그 가능
      cancel: '.ui-resizable-handle', // 리사이즈 핸들에서는 드래그 비활성화
      start: function(event, ui) {
        $(this).addClass('ui-draggable-dragging');
        // 시작 위치 저장
        $(this).data('startLeft', ui.position.left);
        $(this).data('startTop', ui.position.top);
        $(this).data('sourceRow', $(this).closest('.timeline-row'));
      },
      drag: function(event, ui) {
        // 드래그 중 위치에 따른 날짜 업데이트
        updateProjectDates($(this), ui.position.left);

        // 타겟 행 하이라이트
        if (TL_STATE.isEditMode) {
          var $sourceRow = $(this).data('sourceRow');
          var barH = $(this).outerHeight();
          var rowTop = $sourceRow.offset().top;
          var barAbsY = rowTop + ui.position.top + barH / 2;
          var $tb = $('.timeline-body');
          var barContentY = barAbsY - $tb.offset().top + $tb.scrollTop();
          var $target = findTargetTimelineRow(barContentY);

          $('.timeline-row.schedule-row-target').removeClass('schedule-row-target');
          if ($target && $target[0] !== $sourceRow[0]) {
            $target.addClass('schedule-row-target');
          }
        }
      },
      stop: function(event, ui) {
        $(this).removeClass('ui-draggable-dragging');
        $('.timeline-row.schedule-row-target').removeClass('schedule-row-target');

        var $sourceRow = $(this).data('sourceRow');
        var barH = $(this).outerHeight();
        var rowTop = $sourceRow.offset().top;
        var barAbsY = rowTop + ui.position.top + barH / 2;
        var $tb = $('.timeline-body');
        var barContentY = barAbsY - $tb.offset().top + $tb.scrollTop();
        var $targetRow = findTargetTimelineRow(barContentY);

        if (TL_STATE.isEditMode && $targetRow && $targetRow[0] !== $sourceRow[0]) {
          // 다른 행으로 이동
          var movedDates = calculateProjectDates($(this), ui.position.left);
          moveScheduleBarToRow($(this), $sourceRow, $targetRow, movedDates);
        } else {
          $(this).css('top', '2px');

          var finalDates = calculateProjectDates($(this), ui.position.left);
          var scheduleId = $(this).data('schedule-id');
          var scheduleContext = findScheduleContextById(scheduleId);

          console.log('프로젝트 이동 완료:', {
            id: scheduleId,
            startDate: finalDates.startDate,
            endDate: finalDates.endDate
          });

          if (scheduleContext) {
            scheduleContext.schedule.startDate = formatLocalDate(finalDates.startDate);
            scheduleContext.schedule.endDate = formatLocalDate(finalDates.endDate);
            rebuildColorCachesFromState();
            renderTimelineFromState();
          }

          markDirty();
        }
      }
    });

    // 현재 읽기전용 모드이면 새로 생성된 바도 즉시 disable
    if (typeof TL_STATE !== 'undefined' && !TL_STATE.isEditMode) {
      $elements.draggable('disable').resizable('disable');
    }
  }

  // 이벤트 드래그 앤 드롭 기능 초기화
  function initializeEventDragAndDrop() {
    console.log('이벤트 드래그 앤 드롭 기능 초기화');
    
    var dragStartData = null;
    var dragHelper = null;
    
    // 이벤트 아이템에 드래그 기능 추가
    $(document).on('mousedown', '.project-item .event-content', function(e) {
      if (!TL_STATE.isEditMode) return;
      // 편집 모드에서는 드래그 비활성화
      if ($(this).closest('.project-item').hasClass('editing')) {
        return;
      }
      
      // 오른쪽 클릭 무시
      if (e.which !== 1) {
        return;
      }
      
      var eventItem = $(this).closest('.project-item');
      var sourceCategoryId = eventItem.data('category-id');
      var sourceEventId = eventItem.data('event-id');
      var eventContext = findEventContextById(sourceEventId);
      
      dragStartData = {
        eventItem: eventItem,
        eventId: sourceEventId,
        eventName: eventContext ? eventContext.event.name : eventItem.find('.project-name').text().trim(),
        sourceCategoryId: sourceCategoryId,
        startX: e.pageX,
        startY: e.pageY,
        isDragging: false
      };
      
      console.log('드래그 시작 준비:', dragStartData);
      
      // 전역 마우스 이벤트 추가
      $(document).on('mousemove.eventDrag', handleMouseMove);
      $(document).on('mouseup.eventDrag', handleMouseUp);
      
      e.preventDefault();
    });
    
    function handleMouseMove(e) {
      if (!dragStartData) return;
      
      var deltaX = Math.abs(e.pageX - dragStartData.startX);
      var deltaY = Math.abs(e.pageY - dragStartData.startY);
      
      // 드래그 시작 임계값 확인
      if (!dragStartData.isDragging && (deltaX > 5 || deltaY > 5)) {
        startDrag(e);
      }
      
      if (dragStartData.isDragging) {
        updateDragPosition(e);
        updateDropZones(e);
      }
    }
    
    function handleMouseUp(e) {
      if (dragStartData && dragStartData.isDragging) {
        finishDrag(e);
      }
      
      // 전역 이벤트 제거
      $(document).off('mousemove.eventDrag');
      $(document).off('mouseup.eventDrag');
      
      dragStartData = null;
    }
    
    function startDrag(e) {
      console.log('드래그 시작:', dragStartData.eventName);
      
      dragStartData.isDragging = true;
      dragStartData.eventItem.addClass('dragging');
      
      // 드래그 헬퍼 생성 (XSS-safe)
      dragHelper = $('<div class="project-item drag-helper">');
      var $helperContent = $('<div class="event-content">');
      $helperContent.append($('<div class="project-name">').text(dragStartData.eventName));
      dragHelper.append($helperContent);
      
      $('body').append(dragHelper);
      updateDragPosition(e);
      
      // 드롭 존 활성화
      // 1. 다른 카테고리 헤더들을 드롭 존으로 설정
      $('.category-header').not('[data-category-id="' + dragStartData.sourceCategoryId + '"]')
                          .addClass('drop-zone');
      
      // 2. 같은 카테고리 내의 다른 이벤트들을 드롭 존으로 설정
      $('.project-item[data-category-id="' + dragStartData.sourceCategoryId + '"]')
                          .not(dragStartData.eventItem)
                          .addClass('drop-zone');
    }
    
    function updateDragPosition(e) {
      if (dragHelper) {
        dragHelper.css({
          left: e.pageX + 10,
          top: e.pageY - 10
        });
      }
    }
    
    function updateDropZones(e) {
      // 현재 마우스 위치의 드롭 존 찾기
      var categoryDropTarget = $(e.target).closest('.category-header.drop-zone');
      var eventDropTarget = $(e.target).closest('.project-item.drop-zone');
      
      // 모든 드롭 존에서 hover 효과 제거
      $('.category-header.drop-zone').removeClass('drop-zone-hover');
      $('.project-item.drop-zone').removeClass('drop-zone-hover');
      
      // 현재 위치의 드롭 존에 hover 효과 추가 및 헬퍼 텍스트 업데이트
      if (categoryDropTarget.length > 0) {
        categoryDropTarget.addClass('drop-zone-hover');
        updateDragHelperText('카테고리 이동');
      } else if (eventDropTarget.length > 0) {
        eventDropTarget.addClass('drop-zone-hover');
        updateDragHelperText('순서 변경');
      } else {
        updateDragHelperText('이동');
      }
    }
    
    function updateDragHelperText(action) {
      if (dragHelper) {
        var helperText = dragHelper.find('.drag-helper-action');
        if (helperText.length === 0) {
          dragHelper.append('<div class="drag-helper-action" style="font-size: 10px; color: #666; margin-top: 2px;"></div>');
          helperText = dragHelper.find('.drag-helper-action');
        }
        helperText.text(action);
      }
    }
    
    function finishDrag(e) {
      console.log('드래그 완료');
      
      // 드롭 타겟 찾기
      var categoryDropTarget = $(e.target).closest('.category-header.drop-zone');
      var eventDropTarget = $(e.target).closest('.project-item.drop-zone');
      
      if (categoryDropTarget.length > 0) {
        // 카테고리 헤더에 드롭 - 다른 카테고리로 이동
        var targetCategoryId = categoryDropTarget.data('category-id');
        
        if (targetCategoryId !== dragStartData.sourceCategoryId) {
          try {
            moveEventToCategory(dragStartData.eventId, dragStartData.sourceCategoryId, targetCategoryId);
          } catch (error) {
            console.error('이벤트 이동 중 오류 발생:', error);
            alert('이벤트 이동 중 오류가 발생했습니다. 페이지를 새로고침해주세요.');
          }
        } else {
          console.log('같은 카테고리로 이동 시도 - 무시');
        }
      } else if (eventDropTarget.length > 0) {
        // 이벤트 아이템에 드롭 - 같은 카테고리 내 순서 변경
        var targetEventCategoryId = eventDropTarget.data('category-id');
        var targetEventId = eventDropTarget.data('event-id');
        
        if (targetEventCategoryId === dragStartData.sourceCategoryId) {
          try {
            reorderEventInCategory(dragStartData.eventId, targetEventId);
          } catch (error) {
            console.error('이벤트 순서 변경 중 오류 발생:', error);
            alert('이벤트 순서 변경 중 오류가 발생했습니다. 페이지를 새로고침해주세요.');
          }
        } else {
          console.log('다른 카테고리의 이벤트에 드롭 - 무시');
        }
      }
      
      // 정리
      cleanup();
    }
    
    function cleanup() {
      if (dragHelper) {
        dragHelper.remove();
        dragHelper = null;
      }
      
      $('.project-item').removeClass('dragging');
      $('.category-header').removeClass('drop-zone drop-zone-hover');
      $('.project-item').removeClass('drop-zone drop-zone-hover');
    }
    
    function moveEventToCategory(eventId, sourceCategoryId, targetCategoryId) {
      console.log('이벤트 카테고리 이동:', sourceCategoryId, '->', targetCategoryId);

      var eventContext = findEventContextById(eventId);
      var targetCategoryContext = findCategoryContextById(targetCategoryId);
      if (!eventContext || !targetCategoryContext) {
        console.error('이벤트 또는 타겟 카테고리를 찾을 수 없습니다');
        return;
      }

      var eventData = eventContext.event;
      eventContext.category.events.splice(eventContext.eventIndex, 1);
      targetCategoryContext.category.events.push(eventData);

      renderTimelineFromState();
      markDirty();
      console.log('이벤트 이동 완료:', eventData.name);
    }
    
    // 같은 카테고리 내에서 이벤트 순서 변경
    function reorderEventInCategory(sourceEventId, targetEventId) {
      console.log('이벤트 순서 변경 시작');

      var sourceEventContext = findEventContextById(sourceEventId);
      var targetEventContext = findEventContextById(targetEventId);
      if (!sourceEventContext || !targetEventContext) return;
      if (sourceEventContext.category.id !== targetEventContext.category.id) return;

      var categoryEvents = sourceEventContext.category.events;
      var movedEvent = categoryEvents.splice(sourceEventContext.eventIndex, 1)[0];
      var insertIndex = targetEventContext.eventIndex;
      categoryEvents.splice(insertIndex, 0, movedEvent);

      renderTimelineFromState();
      markDirty();
      console.log('이벤트 순서 변경 완료:', sourceEventContext.event.name);
    }
    
    // 타임라인에서 새 이벤트 행의 삽입 위치를 찾는 함수
    function findTimelineInsertPosition(categoryIndex, eventName) {
      var categoryName = $('.category-header[data-category-index="' + categoryIndex + '"]')
                         .find('.category-title').text().trim();
      
      console.log('타임라인 삽입 위치 찾기:', categoryName, eventName);
      
      // 해당 카테고리의 기존 타임라인 행들 찾기
      var categoryTimelineRows = $('.timeline-row[data-category-name="' + categoryName + '"]');
      console.log('기존 카테고리 타임라인 행 개수:', categoryTimelineRows.length);
      
      if (categoryTimelineRows.length > 0) {
        return categoryTimelineRows.last();
      }
      
      // 카테고리 행이 없는 경우, 사이드바 순서를 기반으로 삽입 위치 찾기
      var allTimelineRows = $('.timeline-row');
      var sidebarElements = $('.timeline-sidebar').children().not('.sidebar-header');
      
      // 타겟 카테고리의 사이드바 위치 찾기
      var targetCategoryPosition = -1;
      sidebarElements.each(function(index) {
        if ($(this).hasClass('category-header') && 
            $(this).data('category-index') == categoryIndex) {
          targetCategoryPosition = index;
          return false; // break
        }
      });
      
      console.log('타겟 카테고리 위치:', targetCategoryPosition);
      
      if (targetCategoryPosition >= 0) {
        // 타겟 카테고리 이전 요소들 중에서 마지막 타임라인 행 찾기
        var insertAfterRow = null;
        var timelineIndex = 0;
        
        for (var i = 0; i < targetCategoryPosition; i++) {
          var sidebarElement = sidebarElements.eq(i);
          if (sidebarElement.hasClass('category-header') || sidebarElement.hasClass('project-item')) {
            if (timelineIndex < allTimelineRows.length) {
              insertAfterRow = allTimelineRows.eq(timelineIndex);
              timelineIndex++;
            }
          }
        }
        
        console.log('삽입 위치 (이전 행):', insertAfterRow ? insertAfterRow.index() : 'none');
        return insertAfterRow;
      }
      
      // 마지막 수단으로 타임라인 끝에 삽입
      console.log('마지막 수단: 타임라인 끝에 삽입');
      return allTimelineRows.last();
    }
  }

  // 카테고리 드래그 앤 드롭 기능 초기화
  function initializeCategoryDragAndDrop() {
    console.log('카테고리 드래그 앤 드롭 기능 초기화');
    
    var categoryDragData = null;
    var categoryDragHelper = null;
    
    // 카테고리 헤더에 드래그 기능 추가
    $(document).on('mousedown', '.category-header .category-title', function(e) {
      if (!TL_STATE.isEditMode) return;
      // 편집 모드에서는 드래그 비활성화
      if ($(this).closest('.category-header').hasClass('editing')) {
        return;
      }
      
      // 오른쪽 클릭 무시
      if (e.which !== 1) {
        return;
      }
      
      var categoryHeader = $(this).closest('.category-header');
      var categoryName = $(this).text().trim();
      var categoryIndex = categoryHeader.data('category-index');
      var categoryId = categoryHeader.data('category-id');
      
      categoryDragData = {
        categoryHeader: categoryHeader,
        categoryId: categoryId,
        categoryName: categoryName,
        categoryIndex: categoryIndex,
        startX: e.pageX,
        startY: e.pageY,
        isDragging: false
      };
      
      console.log('카테고리 드래그 시작 준비:', categoryDragData);
      
      // 전역 마우스 이벤트 추가
      $(document).on('mousemove.categoryDrag', handleCategoryMouseMove);
      $(document).on('mouseup.categoryDrag', handleCategoryMouseUp);
      $(document).on('keydown.categoryDrag', handleCategoryKeyDown);
      
      e.preventDefault();
    });
    
    // 드래그 중 자동 스크롤 (상/하단 가장자리)
    var autoScrollTimer = null;

    function startAutoScroll(speed) {
      stopAutoScroll();
      var $sc = $('.sidebar-content');
      autoScrollTimer = setInterval(function() {
        var oldTop = $sc.scrollTop();
        $sc.scrollTop(oldTop + speed);
        // 스크롤이 실제로 변했으면 갭 재계산 + 인디케이터 갱신
        if ($sc.scrollTop() !== oldTop && categoryDragData && categoryDragData.isDragging) {
          var gapData = computeCategoryGaps(categoryDragData.categoryIndex);
          categoryDragData.gaps = gapData.gaps;
          categoryDragData.sourceBounds = gapData.sourceBounds;
          // 마지막 마우스 위치로 인디케이터 갱신
          if (categoryDragData.lastMouseEvent) {
            updateCategoryDropZones(categoryDragData.lastMouseEvent);
          }
        }
      }, 16); // ~60fps
    }

    function stopAutoScroll() {
      if (autoScrollTimer) { clearInterval(autoScrollTimer); autoScrollTimer = null; }
    }

    function updateAutoScroll(e) {
      var $sc = $('.sidebar-content');
      var scOffset = $sc.offset();
      var scHeight = $sc.outerHeight();
      var edgeZone = 40; // 가장자리 감지 영역 (px)
      var mouseY = e.pageY;

      var distFromTop = mouseY - scOffset.top;
      var distFromBottom = (scOffset.top + scHeight) - mouseY;

      if (distFromTop < edgeZone && distFromTop >= 0) {
        // 상단 가장자리: 위로 스크롤 (가까울수록 빠르게)
        var intensity = 1 - (distFromTop / edgeZone);
        startAutoScroll(-Math.round(2 + intensity * 8));
      } else if (distFromBottom < edgeZone && distFromBottom >= 0) {
        // 하단 가장자리: 아래로 스크롤
        var intensity = 1 - (distFromBottom / edgeZone);
        startAutoScroll(Math.round(2 + intensity * 8));
      } else {
        stopAutoScroll();
      }
    }

    function handleCategoryMouseMove(e) {
      if (!categoryDragData) return;

      var deltaX = Math.abs(e.pageX - categoryDragData.startX);
      var deltaY = Math.abs(e.pageY - categoryDragData.startY);

      // 드래그 시작 임계값 확인
      if (!categoryDragData.isDragging && (deltaX > 5 || deltaY > 5)) {
        startCategoryDrag(e);
      }

      if (categoryDragData.isDragging) {
        categoryDragData.lastMouseEvent = e;
        updateCategoryDragPosition(e);
        updateCategoryDropZones(e);
        updateAutoScroll(e);
      }
    }
    
    function handleCategoryMouseUp(e) {
      if (categoryDragData && categoryDragData.isDragging) {
        finishCategoryDrag(e);
      }

      // 전역 이벤트 제거
      $(document).off('mousemove.categoryDrag');
      $(document).off('mouseup.categoryDrag');
      $(document).off('keydown.categoryDrag');

      categoryDragData = null;
    }

    function handleCategoryKeyDown(e) {
      if (e.key === 'Escape' && categoryDragData && categoryDragData.isDragging) {
        cleanupCategoryDrag();
        $(document).off('mousemove.categoryDrag');
        $(document).off('mouseup.categoryDrag');
        $(document).off('keydown.categoryDrag');
        categoryDragData = null;
      }
    }
    
    // 갭 기반 삽입: 카테고리 그룹 경계에 갭 계산
    // 반환: { gaps: [...], sourceBounds: { top, bottom } }
    function computeCategoryGaps(sourceCategoryIndex) {
      var gaps = [];
      var categoryGroups = [];
      var $sc = $('.sidebar-content');
      var scOffsetTop = $sc.offset().top;
      var scScrollTop = $sc.scrollTop();

      $sc.find('.category-header').each(function() {
        var $h = $(this);
        var idx = $h.data('category-index');
        var $events = $('.project-item[data-category-index="' + idx + '"]').not('.hidden');
        // offset() 기반: 페이지 좌표에서 컨테이너 좌표로 변환 + 스크롤 보정 → 콘텐츠 좌표
        var top = $h.offset().top - scOffsetTop + scScrollTop;
        var lastEl = $events.length > 0 ? $events.last() : $h;
        var bottom = lastEl.offset().top - scOffsetTop + scScrollTop + lastEl.outerHeight();
        categoryGroups.push({ idx: idx, header: $h, top: top, bottom: bottom });
      });

      // 소스 카테고리 인덱스 찾기
      var srcGroupIdx = -1;
      for (var i = 0; i < categoryGroups.length; i++) {
        if (categoryGroups[i].idx === sourceCategoryIndex) { srcGroupIdx = i; break; }
      }

      // 소스 그룹의 시각적 영역 (noop 존으로 사용)
      var sourceBounds = srcGroupIdx >= 0 ? {
        top: categoryGroups[srcGroupIdx].top,
        bottom: categoryGroups[srcGroupIdx].bottom
      } : null;

      // 갭 생성: 소스 인접 갭은 isNoop (자기 위치 = 이동 없음)
      for (var i = 0; i <= categoryGroups.length; i++) {
        var isNoop = (i === srcGroupIdx || i === srcGroupIdx + 1);

        var yCenter;
        if (i === 0) {
          yCenter = categoryGroups[0].top;
        } else if (i === categoryGroups.length) {
          yCenter = categoryGroups[categoryGroups.length - 1].bottom;
        } else {
          yCenter = (categoryGroups[i - 1].bottom + categoryGroups[i].top) / 2;
        }

        var targetHeader, insertBefore;
        if (i < categoryGroups.length) {
          targetHeader = categoryGroups[i].header;
          insertBefore = true;
        } else {
          targetHeader = categoryGroups[categoryGroups.length - 1].header;
          insertBefore = false;
        }

        gaps.push({ yCenter: yCenter, targetHeader: targetHeader, insertBefore: insertBefore, isNoop: isNoop });
      }

      return { gaps: gaps, sourceBounds: sourceBounds };
    }

    // 마우스 Y 좌표로 가장 가까운 갭 찾기
    // sourceBounds: 소스 그룹의 시각적 영역. 이 안이면 noop, 밖이면 방향 기반 검색.
    function findNearestGap(mouseY, gaps, sourceBounds) {
      var $sc = $('.sidebar-content');
      var localY = mouseY - $sc.offset().top + $sc.scrollTop();

      // 마우스가 소스 그룹 시각 영역 내 → 이동 없음
      if (sourceBounds && localY >= sourceBounds.top && localY <= sourceBounds.bottom) {
        return { isNoop: true };
      }

      // 소스 영역 밖 → 이동 방향의 실제(non-noop) 갭만 검색
      var isBelow = sourceBounds && localY > sourceBounds.bottom;
      var isAbove = sourceBounds && localY < sourceBounds.top;

      var nearest = null, minDist = Infinity;
      for (var i = 0; i < gaps.length; i++) {
        if (gaps[i].isNoop) continue;
        // 아래로 드래그 → 소스 위의 갭 제외, 위로 드래그 → 소스 아래의 갭 제외
        if (isBelow && gaps[i].yCenter < sourceBounds.bottom) continue;
        if (isAbove && gaps[i].yCenter > sourceBounds.top) continue;

        var d = Math.abs(localY - gaps[i].yCenter);
        if (d < minDist) { minDist = d; nearest = gaps[i]; }
      }
      return nearest;
    }

    // 사이드바 갭에 대응하는 타임라인 Y 좌표 계산
    function computeTimelineGapY(gap) {
      var $tb = $('.timeline-body');
      var tbOffsetTop = $tb.offset().top;
      var tbScrollTop = $tb.scrollTop();
      var targetId = gap.targetHeader.data('category-id');
      if (gap.insertBefore) {
        var $tlRow = $('.timeline-row.category-row[data-category-id="' + targetId + '"]');
        if ($tlRow.length > 0) return $tlRow.offset().top - tbOffsetTop + tbScrollTop;
        return 0;
      } else {
        var $allRows = $('.timeline-row[data-category-id="' + targetId + '"]');
        var $lastRow = $allRows.last();
        if ($lastRow.length > 0) return $lastRow.offset().top - tbOffsetTop + tbScrollTop + $lastRow.outerHeight();
        return 0;
      }
    }

    function startCategoryDrag(e) {
      categoryDragData.isDragging = true;
      var srcIdx = categoryDragData.categoryIndex;
      var srcId = categoryDragData.categoryId;
      var srcName = categoryDragData.categoryName;

      // 1. 소스 그룹 전체에 .category-group-dragging 적용
      categoryDragData.categoryHeader.addClass('category-group-dragging');
      $('.project-item[data-category-id="' + srcId + '"]')
        .addClass('category-group-dragging');
      $('.timeline-row[data-category-id="' + srcId + '"]')
        .addClass('category-group-dragging');

      // 2. 개선된 드래그 헬퍼 (카테고리명 + 이벤트 수)
      var eventCount = $('.project-item[data-category-id="' + srcId + '"]').length;
      categoryDragHelper = $('<div class="category-drag-helper">');
      categoryDragHelper.append($('<div class="drag-helper-title">').text(srcName));
      categoryDragHelper.append(
        $('<div class="drag-helper-meta">').text(eventCount + '개 이벤트')
      );
      $('body').append(categoryDragHelper);
      updateCategoryDragPosition(e);

      // 3. 갭 계산 + 인디케이터 생성
      var gapData = computeCategoryGaps(srcIdx);
      categoryDragData.gaps = gapData.gaps;
      categoryDragData.sourceBounds = gapData.sourceBounds;
      categoryDragData.$sidebarIndicator =
        $('<div class="category-gap-indicator">').appendTo('.sidebar-content');
      categoryDragData.$timelineIndicator =
        $('<div class="timeline-gap-indicator">').appendTo('.timeline-body');
    }

    function updateCategoryDragPosition(e) {
      if (categoryDragHelper) {
        categoryDragHelper.css({
          left: e.pageX + 10,
          top: e.pageY - 10
        });
      }
    }

    function updateCategoryDropZones(e) {
      var gap = findNearestGap(e.pageY, categoryDragData.gaps, categoryDragData.sourceBounds);
      categoryDragData.currentGap = gap;

      if (gap && !gap.isNoop) {
        // 실제 이동 갭: 인디케이터 표시
        categoryDragData.$sidebarIndicator.css({
          top: gap.yCenter + 'px', display: 'block'
        });
        var tlY = computeTimelineGapY(gap);
        categoryDragData.$timelineIndicator.css({
          top: tlY + 'px', display: 'block'
        });
      } else {
        // 자기 위치(noop) 또는 갭 없음: 인디케이터 숨김
        categoryDragData.$sidebarIndicator.hide();
        categoryDragData.$timelineIndicator.hide();
      }
    }

    function finishCategoryDrag(e) {
      var gap = categoryDragData.currentGap;
      if (gap && !gap.isNoop) {
        try {
          reorderCategory(categoryDragData.categoryId, gap.targetHeader.data('category-id'), gap.insertBefore);
        } catch (error) {
          console.error('카테고리 순서 변경 중 오류:', error);
        }
      }
      cleanupCategoryDrag();
    }

    function cleanupCategoryDrag() {
      stopAutoScroll();
      if (categoryDragHelper) { categoryDragHelper.remove(); categoryDragHelper = null; }
      if (categoryDragData && categoryDragData.$sidebarIndicator) categoryDragData.$sidebarIndicator.remove();
      if (categoryDragData && categoryDragData.$timelineIndicator) categoryDragData.$timelineIndicator.remove();

      $('.category-group-dragging').removeClass('category-group-dragging');
      // 기존 클래스 안전 정리
      $('.category-header').removeClass(
        'dragging category-drop-zone category-drop-zone-hover drop-before drop-after'
      );
    }
    
    // 카테고리 순서 변경 함수
    function reorderCategory(sourceCategoryId, targetCategoryId, insertBefore) {
      console.log('카테고리 순서 변경 시작');

      var timeline = ensureTimelineState();
      var sourceContext = findCategoryContextById(sourceCategoryId);
      var targetContext = findCategoryContextById(targetCategoryId);
      if (!sourceContext || !targetContext) return;

      console.log('순서 변경:', sourceContext.category.name, '→', targetContext.category.name, '(삽입 위치:', insertBefore ? '위' : '아래', ')');

      var movedCategory = timeline.categories.splice(sourceContext.categoryIndex, 1)[0];
      var targetIndex = findCategoryContextById(targetCategoryId).categoryIndex;
      var insertIndex = insertBefore ? targetIndex : targetIndex + 1;
      timeline.categories.splice(insertIndex, 0, movedCategory);

      renderTimelineFromState();
      markDirty();
      console.log('카테고리 순서 변경 완료');
    }
    
    // 타임라인에서 카테고리 순서 변경
    function reorderTimelineForCategory(sourceCategoryName, targetCategoryName, insertBefore) {
      console.log('타임라인 카테고리 순서 변경:', sourceCategoryName, '→', targetCategoryName);
      
      // 1단계: 타임라인에서 카테고리 이름으로 카테고리 행과 이벤트 행들 찾기
      var sourceCategoryRow = $('.timeline-row.category-row[data-category-name="' + sourceCategoryName + '"]');
      var targetCategoryRow = $('.timeline-row.category-row[data-category-name="' + targetCategoryName + '"]');
      var sourceEventRows = $('.timeline-row[data-category-name="' + sourceCategoryName + '"]').not('.category-row');
      var targetEventRows = $('.timeline-row[data-category-name="' + targetCategoryName + '"]').not('.category-row');
      
      console.log('소스 카테고리 행:', sourceCategoryRow.length);
      console.log('소스 이벤트 행 수:', sourceEventRows.length);
      console.log('타겟 카테고리 행:', targetCategoryRow.length);
      console.log('타겟 이벤트 행 수:', targetEventRows.length);
      
      if (sourceCategoryRow.length === 0) {
        console.error('소스 카테고리 행을 찾을 수 없습니다:', sourceCategoryName);
        return;
      }
      
      if (targetCategoryRow.length === 0) {
        console.error('타겟 카테고리 행을 찾을 수 없습니다:', targetCategoryName);
        return;
      }
      
      // 2단계: 행들 이동 (카테고리 행 + 모든 이벤트 행)
      var sourceRows = [sourceCategoryRow[0]].concat(sourceEventRows.toArray());
      
      console.log('이동할 총 행 수:', sourceRows.length);
      
      if (insertBefore) {
        // 타겟 카테고리 위에 삽입 (정순 삽입으로 순서 유지)
        for (var i = 0; i < sourceRows.length; i++) {
          $(sourceRows[i]).detach().insertBefore(targetCategoryRow);
        }
        console.log('타겟 카테고리 위에 삽입 완료');
      } else {
        // 타겟 카테고리의 마지막 이벤트 다음에 삽입
        var insertAfter = targetEventRows.length > 0 ? targetEventRows.last() : targetCategoryRow;
        sourceRows.forEach(function(row) {
          $(row).detach().insertAfter(insertAfter);
          insertAfter = $(row); // 다음 삽입 위치 업데이트
        });
        console.log('타겟 카테고리 뒤에 삽입 완료');
      }
      
      console.log('타임라인 카테고리 순서 변경 완료');
    }
  }

  // 타임라인의 모든 라인 높이 업데이트 함수
  function updateLineHeight() {
    var timelineBody = $('.timeline-body');

    console.log( "updateLineHeight!!" );
    
    if (timelineBody.length > 0) {
      var timelineHeight = timelineBody[0].scrollHeight; // 스크롤 가능한 전체 높이
      
      // today-line 높이 업데이트
      var todayLine = $('.today-line');
      if (todayLine.length > 0) {
        var todayNewHeight = timelineHeight + 50; // top: -50px 보정
        todayLine.css('height', todayNewHeight + 'px');
      }
      
      // date-grid-line 높이 업데이트
      var dateGridLines = $('.date-grid-line');
      if (dateGridLines.length > 0) {
        dateGridLines.css('height', timelineHeight + 'px');
      }
    }
  }

  // RGB 색상을 HEX로 변환하는 함수
  function rgbToHex(rgb) {
    if (!rgb || rgb.indexOf('rgb') !== 0) return rgb;
    
    var rgbMatch = rgb.match(/^rgb\((\d+),\s*(\d+),\s*(\d+)\)$/);
    if (!rgbMatch) return rgb;
    
    function hex(x) {
      return ("0" + parseInt(x).toString(16)).slice(-2);
    }
    
    return "#" + hex(rgbMatch[1]) + hex(rgbMatch[2]) + hex(rgbMatch[3]);
  }

  // 스케줄 바 업데이트 함수
  function updateScheduleBar(scheduleId, scheduleData) {
    var scheduleContext = findScheduleContextById(scheduleId);
    if (!scheduleContext) return;

    scheduleContext.schedule.name = scheduleData.name;
    scheduleContext.schedule.startDate = formatLocalDate(scheduleData.start_date);
    scheduleContext.schedule.endDate = formatLocalDate(scheduleData.end_date);
    scheduleContext.schedule.issue = scheduleData.issue || '';
    scheduleContext.schedule.customColor = scheduleData.color || null;

    rebuildColorCachesFromState();
    renderTimelineFromState();
    console.log('스케줄 바 업데이트 완료:', scheduleData.name);
  }

  // 프로젝트 정보 업데이트 함수 (스케줄 개수만 표시)
  function updateProjectInfo(eventRef, categoryRef) {
    var eventContext = findEventContextById(eventRef);
    if (!eventContext && eventRef && categoryRef) {
      var categories = ensureTimelineState().categories;
      for (var i = 0; i < categories.length; i++) {
        if (categories[i].name !== categoryRef && categories[i].id !== categoryRef) continue;
        for (var j = 0; j < categories[i].events.length; j++) {
          if (categories[i].events[j].name === eventRef || categories[i].events[j].id === eventRef) {
            eventContext = {
              category: categories[i],
              event: categories[i].events[j]
            };
            break;
          }
        }
      }
    }

    if (!eventContext) return;

    var info = eventContext.event.schedules.length + '개 스케줄';
    $('.project-item[data-event-id="' + eventContext.event.id + '"]').find('.project-info').text(info);
    console.log('프로젝트 정보 업데이트:', eventContext.event.name, '->', info);
  }

  // currentTimelineName과 일치하는 탭을 선택하는 함수
  function selectTimelineTab(timelineName) {
    // 모든 탭에서 selected 클래스 제거
    $('.timeline-tab').removeClass('selected');
    
    // 일치하는 탭 찾기
    var targetTab = $('.timeline-tab[data-timeline-name="' + timelineName + '"]');
    
    // 해당 탭이 없으면 첫 번째 탭 선택
    if (targetTab.length === 0) {
      console.warn('탭을 찾을 수 없음:', timelineName, '- 첫 번째 탭 선택');
      targetTab = $('.timeline-tab').first();
      if (targetTab.length > 0) {
        var firstTimelineName = targetTab.data('timeline-name');
        currentTimelineName = firstTimelineName;
        TL_STATE.currentTimelineName = firstTimelineName;
        timelineName = firstTimelineName;
      }
    }
    
    // 선택된 탭에 selected 클래스 추가
    targetTab.addClass('selected');
    currentTimelineName = timelineName;
    TL_STATE.currentTimelineName = timelineName;
    
    console.log('탭 선택됨:', timelineName);
  }
  
</script>

<script>

  function addNewCategory(categoryName) {
    console.log('새 카테고리 추가:', categoryName);

    var timeline = ensureTimelineState();
    timeline.categories.push({
      id: nextTimelineEntityId('category'),
      name: categoryName,
      customColor: TL_CONST.DEFAULT_COLOR,
      events: []
    });

    rebuildColorCachesFromState();
    renderTimelineFromState();
    markDirty();
  }

  function addNewEvent(categoryId, eventData) {
    console.log('=== 새 이벤트 추가 시작 ===');

    var context = findCategoryContextById(categoryId);
    if (!context) {
      console.error('카테고리를 찾을 수 없습니다:', categoryId);
      return;
    }

    context.category.events.push({
      id: eventData.id || nextTimelineEntityId('event'),
      name: eventData.name,
      schedules: []
    });

    renderTimelineFromState();
    markDirty();
    console.log('=== 새 이벤트 추가 완료 ===');
  }

  function hideEventPopup() {
    $('#eventPopup').removeClass('show');
    currentEditingCategory = null;
  }

  function hideSchedulePopup() {
    $('#schedulePopup').removeClass('show');
    currentEditingSchedule = null;
  }

  function hideColorPickerPopup() {
    $('#colorPickerPopup').removeClass('show');
    $('#colorPickerNameSection').hide();
    currentColorEditingTarget = null;
    selectedColor = TL_CONST.DEFAULT_COLOR;
  }

  function updateColorSelection(color) {
    $('.color-preset-item').removeClass('selected');
    $('.color-preset-item[data-color="' + color + '"]').addClass('selected');
    $('#colorPreviewBar').css('background-color', color);
    $('#customColorPicker').val(color);
  }

</script>
